@model TMSBilling.Controllers.ProductViewModel

@{
    var order = ViewBag.Order;
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    ViewData["Title"] = "Order Load DO : " + order.inv_no + ", " + order.cnee_code;
}

<style>
    /* =========================================================
           ENTERPRISE COMPACT THEME
           Visual-only redesign. Existing IDs/names/JS are preserved.
           ========================================================= */

    :root {
        --ol-bg: #f4f6f9;
        --ol-surface: #ffffff;
        --ol-border: #dfe4ea;
        --ol-border-dark: #cbd2da;
        --ol-text: #27313d;
        --ol-muted: #6b7480;
        --ol-primary: #1f5f9d;
        --ol-primary-dark: #174b7c;
        --ol-primary-soft: #edf4fb;
        --ol-danger: #c53b3b;
        --ol-warning: #b7791f;
        --ol-radius: 6px;
    }

    .order-load-page {
        color: var(--ol-text);
        font-size: 12px;
        background: var(--ol-bg);
        padding: 8px 10px 14px;
        min-height: calc(100vh - 70px);
    }

    .order-load-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 8px;
        padding: 7px 9px;
        background: var(--ol-surface);
        border: 1px solid var(--ol-border);
        border-radius: var(--ol-radius);
        box-shadow: 0 1px 3px rgba(25, 35, 45, .05);
    }

    .order-load-heading {
        display: flex;
        align-items: center;
        min-width: 0;
        gap: 9px;
    }

    .order-load-heading-icon {
        width: 29px;
        height: 29px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 5px;
        background: var(--ol-primary-soft);
        color: var(--ol-primary);
        flex: 0 0 auto;
    }

    .order-load-heading-title {
        margin: 0;
        font-size: 14px;
        line-height: 1.2;
        font-weight: 700;
        color: #243447;
    }

    .order-load-heading-subtitle {
        margin: 2px 0 0;
        font-size: 10px;
        color: var(--ol-muted);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .order-load-actions {
        display: flex;
        align-items: center;
        gap: 5px;
        flex: 0 0 auto;
    }

        .order-load-actions .btn {
            height: 29px;
            padding: 3px 10px;
            font-size: 11px;
            border-radius: 4px;
            font-weight: 600;
        }

    .order-load-summary {
        display: flex;
        align-items: center;
        gap: 5px;
        padding: 3px 7px;
        border: 1px solid var(--ol-border);
        border-radius: 4px;
        background: #fafbfc;
        color: var(--ol-muted);
        font-size: 10px;
        white-space: nowrap;
    }

        .order-load-summary strong {
            color: var(--ol-text);
            font-weight: 700;
        }

    .load-card {
        background: var(--ol-surface);
        border: 1px solid var(--ol-border);
        border-radius: var(--ol-radius);
        box-shadow: 0 1px 3px rgba(25, 35, 45, .05);
        overflow: hidden;
    }

    .load-card-header {
        min-height: 34px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 6px 10px;
        border-bottom: 1px solid var(--ol-border);
        background: #fafbfc;
    }

    .load-card-title {
        display: flex;
        align-items: center;
        gap: 7px;
        margin: 0;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .35px;
        color: #3b4754;
    }

        .load-card-title i {
            color: var(--ol-primary);
            font-size: 12px;
        }

    .load-card-meta {
        color: var(--ol-muted);
        font-size: 10px;
    }

    .table-container {
        width: 100%;
        overflow-x: auto;
        overflow-y: visible;
    }

    .order-load-table {
        width: 100%;
        min-width: 920px;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
        font-size: 11px;
        color: var(--ol-text);
    }

        .order-load-table thead th {
            position: sticky;
            top: 0;
            z-index: 2;
            padding: 7px 7px;
            border-right: 1px solid #3f4c59;
            border-bottom: 1px solid #27333f;
            background: #354250;
            color: #fff;
            font-size: 10px;
            font-weight: 700;
            line-height: 1.15;
            text-align: center;
            vertical-align: middle;
            white-space: nowrap;
        }

            .order-load-table thead th:last-child {
                border-right: 0;
            }

        .order-load-table tbody td {
            padding: 5px 7px;
            height: 31px;
            border-right: 1px solid var(--ol-border);
            border-bottom: 1px solid var(--ol-border);
            background: #fff;
            vertical-align: middle;
            white-space: nowrap;
        }

        .order-load-table tbody tr:nth-child(even) td {
            background: #fbfcfd;
        }

        .order-load-table tbody tr:hover td {
            background: #f1f6fb;
        }

        .order-load-table tbody td:last-child {
            border-right: 0;
        }

        .order-load-table .col-narrow {
            width: auto;
            min-width: 78px;
        }

        .order-load-table .col-action {
            width: 86px;
            min-width: 86px;
        }

        .order-load-table th:first-child,
        .order-load-table td:first-child {
            width: 38px;
            min-width: 38px;
            text-align: center;
            color: var(--ol-muted);
        }

        .order-load-table td:nth-child(2) {
            min-width: 190px;
            max-width: 280px;
            overflow: hidden;
            text-overflow: ellipsis;
            font-weight: 600;
        }

        .order-load-table td:nth-child(3) {
            min-width: 125px;
        }

        .order-load-table td:nth-child(4) {
            min-width: 90px;
        }

        .order-load-table td:nth-child(5),
        .order-load-table td:nth-child(6),
        .order-load-table td:nth-child(7),
        .order-load-table td:nth-child(8),
        .order-load-table td:nth-child(9),
        .order-load-table td:nth-child(10) {
            text-align: right;
            font-variant-numeric: tabular-nums;
        }

    .load-empty {
        padding: 34px 15px !important;
        text-align: center;
        color: var(--ol-muted);
        background: #fff !important;
    }

        .load-empty i {
            display: block;
            margin-bottom: 7px;
            font-size: 20px;
            color: #aeb7c1;
        }

    /* Product search modal */
    #productModal .modal-dialog {
        max-width: 820px;
    }

    #productModal .modal-content,
    #productDetailsModal .modal-content {
        border: 1px solid var(--ol-border);
        border-radius: 7px;
        overflow: hidden;
        box-shadow: 0 12px 40px rgba(20, 30, 40, .18);
    }

    #productModal .modal-header,
    #productDetailsModal .modal-header {
        min-height: 42px;
        padding: 8px 12px;
        background: #354250;
        color: #fff;
        border-bottom: 0;
    }

    #productModal .modal-title,
    #productDetailsModal .modal-title {
        margin: 0;
        font-size: 13px;
        font-weight: 700;
    }

    #productModal .btn-close,
    #productDetailsModal .btn-close {
        filter: brightness(0) invert(1);
        opacity: .8;
    }

    #productModal .modal-body,
    #productDetailsModal .modal-body {
        padding: 11px;
        background: #f7f9fb;
    }

    #productModal .modal-footer,
    #productDetailsModal .modal-footer {
        padding: 8px 11px;
        border-top: 1px solid var(--ol-border);
        background: #fff;
    }

        #productModal .modal-footer .btn,
        #productDetailsModal .modal-footer .btn {
            min-width: 78px;
            padding: 5px 10px;
            font-size: 11px;
            font-weight: 600;
        }

    .product-search {
        max-height: 420px;
        overflow-y: auto;
        padding-right: 2px;
    }

    #productSearch {
        height: 32px;
        border: 1px solid var(--ol-border-dark);
        border-radius: 4px;
        font-size: 11px;
        padding: 5px 9px;
        box-shadow: none;
    }

        #productSearch:focus {
            border-color: #7aa7d3;
            box-shadow: 0 0 0 2px rgba(31, 95, 157, .08);
        }

    .product-item {
        cursor: pointer;
        padding: 8px 9px;
        margin-bottom: 4px;
        border: 1px solid var(--ol-border);
        border-radius: 5px;
        background: #fff;
        transition: border-color .15s, background-color .15s;
    }

        .product-item:hover {
            background: #f4f8fc;
            border-color: #9ebbd7;
        }

        .product-item.selected {
            background: var(--ol-primary-soft);
            border-color: #7da9d2;
        }

        .product-item h6 {
            font-size: 11px;
            font-weight: 700;
            color: #2f3b47;
        }

        .product-item small {
            font-size: 10px;
        }

    /* Product detail form */
    #productDetailsModal .modal-dialog {
        max-width: 650px;
    }

    #productDetailsForm .form-label {
        display: block;
        margin-bottom: 3px;
        font-size: 10px;
        line-height: 1.2;
        font-weight: 700;
        color: #56616d;
    }

    #productDetailsForm .form-control {
        height: 31px;
        padding: 4px 8px;
        border: 1px solid var(--ol-border-dark);
        border-radius: 4px;
        font-size: 11px;
        box-shadow: none;
    }

        #productDetailsForm .form-control:focus {
            border-color: #7aa7d3;
            box-shadow: 0 0 0 2px rgba(31, 95, 157, .08);
        }

    #productDetailsForm .mb-3 {
        margin-bottom: 8px !important;
    }

    #productDetailsForm .row {
        --bs-gutter-x: 8px;
    }

    #productDetailsForm .input-group .btn {
        width: 36px;
        padding: 0;
        border-radius: 0 4px 4px 0;
        font-size: 12px;
    }

    #productDetailsForm .input-group .form-control {
        border-radius: 4px 0 0 4px;
    }

    @@media (max-width: 900px) {
        .order-load-toolbar {
            align-items: flex-start;
            flex-direction: column;
        }

        .order-load-actions {
            width: 100%;
            justify-content: flex-end;
        }

        .order-load-summary {
            display: none;
        }
    }

    @@media (max-width: 576px) {
        .order-load-page {
            padding: 5px;
        }

        .order-load-actions {
            justify-content: flex-start;
            flex-wrap: wrap;
        }

        .order-load-heading-subtitle {
            max-width: 220px;
        }

        #productDetailsModal .modal-dialog,
        #productModal .modal-dialog {
            margin: 6px;
        }
    }
</style>

<div class="order-load-page">

    <div class="order-load-toolbar">
        <div class="order-load-heading">
            <div class="order-load-heading-icon">
                <i class="bi bi-box-seam"></i>
            </div>
            <div>
                <h1 class="order-load-heading-title">Order Load</h1>
                <div class="order-load-heading-subtitle">
                    Order #@order.id_seq
                    @if (order.inv_no != null)
                    {
                        <span> · Invoice @order.inv_no</span>
                    }
                    @if (order.cnee_code != null)
                    {
                        <span> · @order.cnee_code</span>
                    }
                </div>
            </div>
        </div>

        <div class="order-load-actions">
            <div class="order-load-summary">
                <span>Items</span>
                <strong id="orderLoadItemCount">0</strong>
            </div>

            <button type="button"
                    class="btn btn-sm btn-light border"
                    onclick="window.location.href='/Order/Form/@order.id_seq'">
                <i class="bi bi-arrow-left me-1"></i> Back
            </button>

            <button type="button"
                    class="btn btn-sm btn-primary"
                    onclick="openProductModal()">
                <i class="fas fa-plus me-1"></i> Add Item
            </button>
        </div>
    </div>

    <div class="load-card">

        <div class="load-card-header">
            <h2 class="load-card-title">
                <i class="bi bi-list-columns-reverse"></i>
                Loaded Items
            </h2>
            <span class="load-card-meta">Product / package details</span>
        </div>

        <div class="table-container">
            <table class="table order-load-table">
                <thead>
                    <tr>
                        <th class="col-narrow">#</th>
                        <th class="col-narrow">Item Name</th>
                        <th class="col-narrow">Item Category</th>
                        <th class="col-narrow">Package Unit</th>
                        <th class="col-narrow">Length<br>(cm)</th>
                        <th class="col-narrow">Width<br>(cm)</th>
                        <th class="col-narrow">Height<br>(cm)</th>
                        <th class="col-narrow">Weight<br>(kg)</th>
                        <th class="col-narrow">Qty<br>(Koli)</th>
                        <th class="col-narrow">Qty<br>(Pcs)</th>
                        <th class="col-action">Action</th>
                    </tr>
                </thead>

                <tbody id="detailTableBody">
                    <tr id="loadEmptyRow">
                        <td colspan="11" class="load-empty">
                            <i class="bi bi-inbox"></i>
                            No items loaded
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Product Search Modal -->
    <div class="modal fade"
         id="productModal"
         tabindex="-1"
         aria-labelledby="productModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-lg">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="productModalLabel">
                        <i class="fas fa-boxes me-2"></i>Select Product
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"></button>
                </div>

                <div class="modal-body">

                    <div class="mb-2">
                        <input type="text"
                               class="form-control"
                               id="productSearch"
                               placeholder="Search by product name, SKU, or category..."
                               onkeyup="searchProducts()">
                    </div>

                    <div class="product-search" id="productList">
                        <!-- Product items akan dimuat via JavaScript -->
                    </div>

                </div>
            </div>
        </div>
    </div>

    <!-- Product Details Modal -->
    <div class="modal fade"
         id="productDetailsModal"
         tabindex="-1"
         aria-labelledby="productDetailsModalLabel"
         aria-hidden="true">

        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="productDetailsModalLabel">
                        <i class="fas fa-box-open me-2"></i>Product Details
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"></button>
                </div>

                <form id="productDetailsForm"
                      asp-action="SaveProduct"
                      asp-controller="Order"
                      method="post">

                    <div class="modal-body">

                        <input type="hidden" name="id_seq" id="id_seq">
                        <input type="hidden" name="order_h_id" value="@order.id_seq">
                        <input type="hidden" name="product_id" id="selectedProductId">
                        <input type="hidden" name="order_id" value="@ViewBag.OrderIDMcEasy">
                        <input type="hidden" id="editItemIndex" value="-1">

                        <div class="mb-3">
                            <label class="form-label">Product Name</label>

                            <div class="input-group">
                                <input type="text"
                                       class="form-control"
                                       id="productName"
                                       name="name"
                                       readonly>

                                <button type="button"
                                        class="btn btn-success"
                                        onclick="openProductModalForEdit()">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                        </div>

                        <div class="row">
                            <div class="mb-3 col-md-6">
                                <label class="form-label">Category</label>
                                <input type="text"
                                       class="form-control"
                                       id="productCategory"
                                       name="category"
                                       readonly>
                            </div>

                            <div class="mb-3 col-md-6">
                                <label class="form-label">UoM *</label>
                                <input type="text"
                                       class="form-control"
                                       id="packageUnit"
                                       name="uom"
                                       readonly>
                            </div>
                        </div>

                        <div class="load-card mb-2">
                            <div class="load-card-header">
                                <h6 class="load-card-title">
                                    <i class="bi bi-rulers"></i>
                                    Dimensions
                                </h6>
                            </div>

                            <div class="p-2">
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label class="form-label">Length (cm) *</label>
                                            <input type="number"
                                                   class="form-control"
                                                   id="length"
                                                   name="length"
                                                   step="0.01"
                                                   required
                                                   autocomplete="off" />
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label class="form-label">Width (cm) *</label>
                                            <input type="number"
                                                   class="form-control"
                                                   id="width"
                                                   name="width"
                                                   step="0.01"
                                                   required
                                                   autocomplete="off">
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label class="form-label">Height (cm) *</label>
                                            <input type="number"
                                                   class="form-control"
                                                   id="height"
                                                   name="height"
                                                   step="0.01"
                                                   required
                                                   autocomplete="off" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="load-card mb-2">
                            <div class="load-card-header">
                                <h6 class="load-card-title">
                                    <i class="bi bi-box-seam"></i>
                                    Quantity & Weight
                                </h6>
                            </div>

                            <div class="p-2">
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label class="form-label">Weight (kg) *</label>
                                            <input type="number"
                                                   class="form-control"
                                                   name="weight"
                                                   id="weight"
                                                   step="0.01"
                                                   required
                                                   autocomplete="off" />
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label class="form-label">Quantity (Koli) *</label>
                                            <input type="number"
                                                   class="form-control"
                                                   id="quantity"
                                                   name="quantity"
                                                   min="1"
                                                   required
                                                   autocomplete="off" />
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label class="form-label">Quantity (Pcs) *</label>
                                            <input type="number"
                                                   class="form-control"
                                                   id="unit_qty"
                                                   name="unit_qty"
                                                   min="1"
                                                   required
                                                   autocomplete="off" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-1">
                            <label class="form-label">Note</label>
                            <input type="text"
                                   class="form-control"
                                   name="note"
                                   autocomplete="off" />
                        </div>

                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="submit"
                                class="btn btn-primary">
                            <i class="fas fa-save me-1"></i> Save
                        </button>
                    </div>

                </form>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>

        const masterProducts = @Html.Raw(Json.Serialize(ViewBag.MasterProducts))
        console.log(masterProducts)
        // Data items yang sudah ditambahkan
        // let tableItems = [];

        // console.log("@ViewBag.OrderLoad")

        let editLoad = false;

        let orderLoad = @Html.Raw(Json.Serialize(ViewBag.OrderLoad))
                console.log(orderLoad);
        let tableItems = [];
        loadProducts();

                if (orderLoad && orderLoad.length > 0) {
                orderLoad.forEach(item => {
                    // contoh ambil data dari setiap row
                    tableItems.push({
                        id: item.id_seq,
                        productId: item.mceasy_product_id,
                        name: item.item_name,
                        category : item.item_category,
                        quantity: item.item_qty,
                        packageUnit: item.pkg_unit,
                        weight: item.item_wgt,
                        length: item.item_length,
                        width: item.item_width,
                        height: item.item_height,
                        quantity :item.item_qty,
                        unit_qty : item.unit_qty
                    });
                });
            }

            console.log(tableItems);

        // Function untuk membuka modal pencarian product
        function openProductModal() {
            editLoad = false;
            document.getElementById('editItemIndex').value = '-1'; // Reset edit index
            // loadProducts();
            const productModal = new bootstrap.Modal(document.getElementById('productModal'));
            productModal.show();
        }

        // Function untuk load semua products ke modal
        function loadProducts() {
            const productList = document.getElementById('productList');
            productList.innerHTML = '';

            masterProducts.forEach(product => {
                const productItem = createProductItem(product);
                productList.appendChild(productItem);
            });
        }

        // Function untuk membuat elemen product item
        function createProductItem(product) {
            const div = document.createElement('div');
            div.className = 'product-item';
            div.onclick = () => selectProduct(product);

            div.innerHTML = `
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="mb-1">${product.name}</h6>
                        <small class="text-muted">SKU: ${product.sku}</small><br>
                        <small class="text-muted">Category: ${product.product_type.product_category.name}</small>
                    </div>
                    <div class="text-end">
                        <small class="text-muted">UOM: ${product.uom}</small><br>
                        <small class="text-success">${product.price}</small>
                    </div>
                </div>
            `;

            return div;
        }

        // Function untuk search products
        function searchProducts() {
            const searchTerm = document.getElementById('productSearch').value.toLowerCase();
            const productList = document.getElementById('productList');
            productList.innerHTML = '';

            const filteredProducts = masterProducts.filter(product =>
                product.name.toLowerCase().includes(searchTerm) ||
                product.sku.toLowerCase().includes(searchTerm) ||
                product.product_type.product_category.name.toLowerCase().includes(searchTerm)
            );

            filteredProducts.forEach(product => {
                const productItem = createProductItem(product);
                productList.appendChild(productItem);
            });
        }

        // Function untuk select product
        // function selectProduct(product) {
        //     Close product modal
        //     const productModal = bootstrap.Modal.getInstance(document.getElementById('productModal'));
        //     productModal.hide();

        //     Fill product details modal
        //     document.getElementById('id_seq').value = 0;
        //     document.getElementById('selectedProductId').value = product.id;
        //     document.getElementById('productName').value = product.name;
        //     document.getElementById('productCategory').value = product.product_type.product_category.name;
        //     document.getElementById('weight').value = product.weight;
        //     document.getElementById('packageUnit').value = product.uom;

        //     Reset form fields
        //     document.getElementById('packageUnit').value = '';
