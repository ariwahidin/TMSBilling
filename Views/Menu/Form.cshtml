@model TMSBilling.Models.Menu
@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    var isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Edit Menu" : "Create Menu";
    var parentMenus  = ViewBag.ParentMenus  as List<TMSBilling.Models.Menu>       ?? new();
    var permissions  = ViewBag.Permissions  as List<TMSBilling.Models.Permission>  ?? new();
}

<h4 class="mb-3">@ViewData["Title"]</h4>
<input type="hidden" id="MenuId" value="@Model.Id" />

<div class="row">
    <div class="col-md-6">

        <div class="form-group mb-3">
            <label>Name <span class="text-danger">*</span></label>
            <input type="text" id="Name" class="form-control" value="@Model.Name" />
        </div>

        <div class="form-group mb-3">
            <label>URL <span class="text-muted">(kosongkan jika menu group)</span></label>
            <input type="text" id="Url" class="form-control" value="@Model.Url" placeholder="/Controller/Action" />
        </div>

        <div class="form-group mb-3">
            <label>Icon <span class="text-muted">(Font Awesome class)</span></label>
            <div class="input-group">
                <span class="input-group-text"><i id="iconPreview" class="@Model.Icon"></i></span>
                <input type="text" id="Icon" class="form-control" value="@Model.Icon" placeholder="fa fa-home" />
            </div>
        </div>

        <div class="form-group mb-3">
            <label>Parent Menu <span class="text-muted">(optional)</span></label>
            <select id="ParentId" class="form-control">
                <option value="">-- No Parent (Root Menu) --</option>
                @foreach (var menu in parentMenus)
                {
                    <option value="@menu.Id" selected="@(Model.ParentId == menu.Id)">
                        @menu.Name
                    </option>
                }
            </select>
        </div>

        <div class="form-group mb-3">
            <label>Permission</label>
            <select id="PermissionCode" class="form-control">
                <option value="">-- No Permission Required --</option>
                @foreach (var perm in permissions)
                {
                    // <option value="@perm.Code" @(Model.PermissionCode == perm.Code ? "selected" : "")>
                    <option value="@perm.Code" selected="@(Model.PermissionCode == perm.Code)">
                        @perm.Name (@perm.Code)
                    </option>
                }
            </select>
            <small class="text-muted">Menu hanya tampil jika user punya permission ini.</small>
        </div>

        <div class="form-group mb-3">
            <label>Order Index</label>
            <input type="number" id="OrderIndex" class="form-control" value="@Model.OrderIndex" min="0" />
            <small class="text-muted">Urutan tampil menu, angka kecil tampil lebih dulu.</small>
        </div>

        <div class="form-group mb-3">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="IsActive"
                       @(Model.IsActive || Model.Id == 0 ? "checked" : "") />
                <label class="form-check-label" for="IsActive">Active</label>
            </div>
        </div>

        <button id="btnSave" class="btn btn-primary">Save</button>
        <a href="/Menu/Index" class="btn btn-secondary">Cancel</a>
        <div id="resultMsg" class="mt-3"></div>

    </div>
</div>

@section Scripts {
    <script>
        // Preview icon saat user mengetik
        $("#Icon").on("input", function () {
            $("#iconPreview").attr("class", $(this).val());
        });

        $("#btnSave").click(function () {
            const id    = $("#MenuId").val();
            const isEdit = id && id !== "0";

            const data = {
                Id:             parseInt(id) || 0,
                Name:           $("#Name").val().trim(),
                Url:            $("#Url").val().trim(),
                Icon:           $("#Icon").val().trim(),
                ParentId:       $("#ParentId").val() ? parseInt($("#ParentId").val()) : null,
                PermissionCode: $("#PermissionCode").val() || null,
                OrderIndex:     parseInt($("#OrderIndex").val()) || 0,
                IsActive:       $("#IsActive").is(":checked")
            };

            if (!data.Name) {
                showToast("Name is required.", "error");
                return;
            }

            $.ajax({
                url: isEdit ? "/Menu/EditAjax" : "/Menu/CreateAjax",
                method: "POST",
                contentType: "application/json",
                data: JSON.stringify(data),
                success: function (res) {
                    if (res.success) {
                        showToast(res.message, "success");
                        setTimeout(() => window.location.href = '/Menu/Index', 600);
                    }
                },
                error: function (xhr) {
                    const res = xhr.responseJSON;
                    showToast(res?.message ?? "An error occurred.", "error");
                }
            });
        });
    </script>
}