@model TMSBilling.Models.VendorTruckEmail
@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    bool isNew = Model.ID == 0;
    ViewData["Title"] = isNew ? "Add Truck Email" : "Edit Truck Email";
}

<style>
    .form-card {
        max-width: 680px;
        margin: 0 auto;
    }

    .form-label {
        font-size: 0.78rem;
        font-weight: 600;
        color: #495057;
        margin-bottom: 3px;
    }

    .form-control, .form-select {
        font-size: 0.82rem;
    }

        .form-control:focus, .form-select:focus {
            border-color: #86b7fe;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.1);
        }

    .card-header-custom {
        background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
        color: white;
        padding: 0.65rem 1rem;
        border-radius: 8px 8px 0 0;
        font-size: 0.85rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .section-label {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #0d6efd;
        border-bottom: 1.5px solid #e9ecef;
        padding-bottom: 4px;
        margin-bottom: 12px;
        margin-top: 4px;
    }

    .type-radio label {
        font-size: 0.82rem;
    }

    .type-card {
        border: 1.5px solid #dee2e6;
        border-radius: 8px;
        padding: 8px 16px;
        cursor: pointer;
        transition: all 0.15s;
        user-select: none;
    }

        .type-card:hover {
            border-color: #86b7fe;
            background: #f0f7ff;
        }

        .type-card.selected-to {
            border-color: #1a73e8;
            background: #e8f4fd;
            color: #1a73e8;
        }

        .type-card.selected-cc {
            border-color: #e67e00;
            background: #fef3e2;
            color: #e67e00;
        }

    .meta-info {
        font-size: 0.72rem;
        color: #868e96;
    }
</style>

<div class="form-card">
    <div class="card shadow-sm border-0">
        <div class="card-header-custom">
            <i class="bi bi-envelope-plus"></i>
            @ViewData["Title"]
        </div>
        <div class="card-body p-3">

            <form asp-action="@(isNew ? "Create" : "Edit")" method="post">
                <input type="hidden" asp-for="ID" />

                @* Truck Selection *@
                <p class="section-label"><i class="bi bi-truck me-1"></i>Truck Info</p>

                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <label class="form-label">Vendor <span class="text-danger">*</span></label>
                        <select id="ddlVendor" asp-for="sup_code" asp-items="ViewBag.ListVendor"
                                class="form-select form-select-sm select2" required>
                            <option value="">-- Select Vendor --</option>
                        </select>
                        <span asp-validation-for="sup_code" class="text-danger" style="font-size:0.72rem;"></span>
                    </div>

                    @* <div class="col-md-6">
                        <label class="form-label">Truck ID <span class="text-danger"></span></label>
                        <select id="ddlTruck" asp-for="vehicle_no" asp-items="ViewBag.ListTruck"
                                class="form-select form-select-sm select2" required>
                            <option value="">-- Select Truck --</option>
                        </select>
                        <span asp-validation-for="vehicle_no" class="text-danger" style="font-size:0.72rem;"></span>
                    </div> *@
                </div>

                @* Email Details *@
                <p class="section-label mt-3"><i class="bi bi-at me-1"></i>Email Details</p>

                <div class="row g-2 mb-2">
                    <div class="col-md-8">
                        <label class="form-label">Email Address <span class="text-danger">*</span></label>
                        <input asp-for="email_address" class="form-control form-control-sm"
                               placeholder="e.g. recipient@example.com" />
                        <span asp-validation-for="email_address" class="text-danger" style="font-size:0.72rem;"></span>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Display Name</label>
                        <input asp-for="email_name" class="form-control form-control-sm"
                               placeholder="e.g. John Doe" />
                    </div>
                </div>

                @* Email Type (TO / CC) *@
                <div class="mb-2 mt-2">
                    <label class="form-label d-block">Email Type <span class="text-danger">*</span></label>
                    <div class="d-flex gap-3">
                        <label id="cardTO" class="type-card @(Model.email_type == "TO" ? "selected-to" : "")">
                            <input type="radio" name="email_type" value="TO"
                                   class="d-none" @(Model.email_type == "TO" ? "checked" : "") />
                            <i class="bi bi-send me-1"></i> <strong>TO</strong>
                            <div class="meta-info">Primary recipient</div>
                        </label>
                        <label id="cardCC" class="type-card @(Model.email_type == "CC" ? "selected-cc" : "")">
                            <input type="radio" name="email_type" value="CC"
                                   class="d-none" @(Model.email_type == "CC" ? "checked" : "") />
                            <i class="bi bi-person-lines-fill me-1"></i> <strong>CC</strong>
                            <div class="meta-info">Carbon copy</div>
                        </label>
                    </div>
                    <span asp-validation-for="email_type" class="text-danger" style="font-size:0.72rem;"></span>
                </div>

                @* Remark & Status *@
                <div class="row g-2 mt-1">
                    <div class="col-md-8">
                        <label class="form-label">Remark</label>
                        <input asp-for="remark" class="form-control form-control-sm"
                               placeholder="Optional note..." />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label d-block">Status</label>
                        <div class="form-check form-switch mt-1">
                            <input class="form-check-input" type="checkbox" id="activeSwitch"
                                   name="is_active" value="1"
                                   @(Model.is_active == 1 || Model.ID == 0 ? "checked" : "") />
                            <label class="form-check-label" for="activeSwitch" style="font-size:0.82rem;">Active</label>
                        </div>
                    </div>
                </div>

                @* Buttons *@
                <hr class="my-3" />
                <div class="d-flex gap-2 justify-content-end">
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Back
                    </a>
                    @if (isNew)
                    {
                        <a asp-action="Form" class="btn btn-sm btn-outline-info">
                            <i class="bi bi-arrow-clockwise me-1"></i> Reset
                        </a>
                    }
                    <button type="submit" class="btn btn-sm btn-primary">
                        <i class="bi bi-check-lg me-1"></i> Save
                    </button>
                </div>

            </form>
        </div>
    </div>

    @* Audit info for edit mode *@
    @if (!isNew)
    {
        <div class="mt-2 px-1 meta-info">
            @if (Model.entry_date.HasValue)
            {
                <span><i class="bi bi-plus-circle me-1"></i>Created by <strong>@Model.entry_user</strong> on @Model.entry_date.Value.ToString("dd MMM yyyy HH:mm")</span>
            }
            @if (Model.update_date.HasValue)
            {
                <span class="ms-3"><i class="bi bi-pencil me-1"></i>Updated by <strong>@Model.update_user</strong> on @Model.update_date.Value.ToString("dd MMM yyyy HH:mm")</span>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            // Initialize Select2
            $('.select2').select2({
                placeholder: "-- Select --",
                allowClear: true,
                width: '100%'
            });

            // Vendor → Truck cascade
            $('#ddlVendor').on('change', function () {
                var supCode = $(this).val();
                $('#ddlTruck').empty().append('<option value="">-- Select Truck --</option>');

                if (!supCode) return;

                $.get('/VendorTruckEmail/GetTrucksByVendor', { supCode: supCode }, function (data) {
                    $.each(data, function (i, item) {
                        $('#ddlTruck').append(
                            $('<option>').val(item.value).text(item.text)
                        );
                    });
                    $('#ddlTruck').trigger('change'); // refresh select2
                });
            });

            // Email type card toggle
            $('input[name="email_type"]').on('change', function () {
                $('#cardTO, #cardCC').removeClass('selected-to selected-cc');
                if ($(this).val() === 'TO') {
                    $('#cardTO').addClass('selected-to');
                } else {
                    $('#cardCC').addClass('selected-cc');
                }
            });

            // Click on card triggers radio
            $('#cardTO, #cardCC').on('click', function () {
                $(this).find('input[type="radio"]').prop('checked', true).trigger('change');
            });
        });
    </script>
}
