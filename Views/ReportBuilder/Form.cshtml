@model TMSBilling.Models.ReportBuilderFormVM
@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    ViewData["Title"] = Model.Report.ID == 0 ? "New Report" : "Edit Report";
    var isNew  = Model.Report.ID == 0;
    var roles  = ViewBag.Roles as List<string> ?? new List<string>();
}

<div class="page-header mb-3">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h4 class="mb-0">
                <i class="bi bi-tools me-2 text-primary"></i>
                @(isNew ? "New Report Definition" : Model.Report.report_name)
            </h4>
            <small class="text-muted">
                <a href="/ReportBuilder/Index">Report Builder</a> / @(isNew ? "New" : "Edit")
            </small>
        </div>
        <div class="d-flex gap-2">
            @if (!isNew)
            {
                <a href="/Report/Generate/@Model.Report.ID" target="_blank"
                   class="btn btn-sm btn-outline-success">
                    <i class="bi bi-play-circle me-1"></i>Preview as User
                </a>
            }
            <button class="btn btn-sm btn-primary" id="btnSave">
                <i class="bi bi-check-lg me-1"></i>Save Report
            </button>
            <a href="/ReportBuilder" class="btn btn-sm btn-outline-secondary">Cancel</a>
        </div>
    </div>
</div>

<!-- Nav Tabs -->
<ul class="nav nav-tabs mb-3" id="rbTab">
    <li class="nav-item">
        <a class="nav-link active" data-bs-toggle="tab" href="#tabInfo">
            <i class="bi bi-info-circle me-1"></i>Info
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#tabParams">
            <i class="bi bi-sliders me-1"></i>Parameters
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#tabLayout" id="tabLayoutBtn">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i>Excel Layout
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#tabPermissions">
            <i class="bi bi-shield-check me-1"></i>Permissions
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#tabSignature">
            <i class="bi bi-pen me-1"></i>Signature
        </a>
    </li>
</ul>

<div class="tab-content" id="rbTabContent">

    <!-- ════════ TAB 1: INFO ════════ -->
    <div class="tab-pane fade show active" id="tabInfo">
        <div class="row g-3" style="max-width:900px;">
            <div class="col-md-4">
                <label class="form-label">Report Code <span class="text-danger">*</span></label>
                <input id="f_code" class="form-control form-control-sm font-monospace"
                       value="@Model.Report.report_code"
                       placeholder="e.g. DAILY_DELIVERY"
                       @(isNew ? "" : "readonly") />
                <div class="placeholder-hint">Unik, huruf besar, underscore. Tidak bisa diubah setelah save.</div>
            </div>
            <div class="col-md-5">
                <label class="form-label">Report Name <span class="text-danger">*</span></label>
                <input id="f_name" class="form-control form-control-sm"
                       value="@Model.Report.report_name"
                       placeholder="e.g. Daily Delivery Report" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Category</label>
                <input id="f_cat" class="form-control form-control-sm"
                       value="@Model.Report.category"
                       placeholder="e.g. Delivery, Finance" />
            </div>
            <div class="col-12">
                <label class="form-label">Description</label>
                <input id="f_desc" class="form-control form-control-sm"
                       value="@Model.Report.report_desc"
                       placeholder="Short description..." />
            </div>
            <div class="col-md-3">
                <label class="form-label">Icon</label>
                <input id="f_icon" class="form-control form-control-sm font-monospace"
                       value="@(Model.Report.icon ?? "bi-file-earmark-bar-graph")"
                       placeholder="bi-file-earmark-bar-graph" />
                <div class="placeholder-hint">Bootstrap Icons class</div>
            </div>
            <div class="col-md-5">
                <label class="form-label">Filename Template</label>
                <input id="f_filename" class="form-control form-control-sm font-monospace"
                       value="@Model.Report.filename_template"
                       placeholder="e.g. Daily_Delivery_{{date_from}}_{{date_to}}" />
                <div class="placeholder-hint">Support {{placeholder}}. Extension otomatis ditambah.</div>
            </div>
            <div class="col-md-2">
                <label class="form-label">Default Output</label>
                <select id="f_default_out" class="form-select form-select-sm">
                    <option value="excel" selected="@(Model.Report.default_output == "excel" ? "selected" : null)">Excel</option>
                    <option value="csv"   selected="@(Model.Report.default_output == "csv"   ? "selected" : null)">CSV</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Allowed Outputs</label>
                <div class="d-flex flex-column gap-1 mt-1">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="out_excel"
                               @((Model.Report.allowed_outputs ?? "excel").Contains("excel") ? "checked" : "") />
                        <label class="form-check-label" style="font-size:.8rem;" for="out_excel">Excel</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="out_csv"
                               @((Model.Report.allowed_outputs ?? "").Contains("csv") ? "checked" : "") />
                        <label class="form-check-label" style="font-size:.8rem;" for="out_csv">CSV</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="out_pdf"
                               @((Model.Report.allowed_outputs ?? "").Contains("pdf") ? "checked" : "") />
                        <label class="form-check-label" style="font-size:.8rem;" for="out_pdf">PDF</label>
                    </div>
                </div>
            </div>
            <div class="col-md-1">
                <label class="form-label">Active</label>
                <div class="form-check form-switch mt-1">
                    <input class="form-check-input" type="checkbox" id="f_active"
                           @(Model.Report.is_active == 1 ? "checked" : "") />
                </div>
            </div>
        </div>
    </div>

    <!-- ════════ TAB 2: PARAMETERS ════════ -->
    <div class="tab-pane fade" id="tabParams">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="fw-semibold" style="font-size:.83rem;">Parameter Definitions</span>
            <button class="btn btn-sm btn-outline-primary" id="btnAddParam">
                <i class="bi bi-plus-lg me-1"></i>Add Parameter
            </button>
        </div>
        <div class="placeholder-hint mb-3">
            Parameter yang didefinisikan di sini akan muncul sebagai form input di halaman user.
            <code>param_key</code> harus cocok dengan <code>{{placeholder}}</code> di SQL query section.
        </div>
        <div id="paramList"></div>
    </div>

    <!-- ════════ TAB 3: EXCEL LAYOUT ════════ -->
    <div class="tab-pane fade" id="tabLayout">

        <div id="layoutLoading" class="text-muted py-3" style="font-size:.8rem;">
            <span class="spinner-border spinner-border-sm me-1"></span>Loading layout...
        </div>

        <div id="layoutContent" style="display:none;">

            <!-- Toggle -->
            <div class="mb-3">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="el_use_custom" />
                    <label class="form-check-label fw-semibold" for="el_use_custom" style="font-size:.83rem;">
                        Use Custom Excel Layout
                    </label>
                </div>
                <div class="placeholder-hint">Aktifkan untuk pakai layout kustom.</div>
            </div>

            <div id="elMainConfig" style="display:none;">
                <div class="row g-2 mb-3" style="max-width:900px;">
                    <div class="col-md-5">
                        <label class="form-label">Report Title</label>
                        <input id="el_title" class="form-control form-control-sm"
                               placeholder="e.g. Daily Report Periode {{date}}" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Title BG</label>
                        <input type="color" id="el_title_bg" class="form-control form-control-sm form-control-color" value="#FFFFFF" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Title Font</label>
                        <input type="color" id="el_title_fg" class="form-control form-control-sm form-control-color" value="#000000" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Font Size</label>
                        <input type="number" id="el_title_size" class="form-control form-control-sm" min="8" max="36" value="14" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Sub Title <span class="text-muted" style="font-size:.72rem;">— opsional, support {{placeholder}}</span></label>
                        <input id="el_subtitle" class="form-control form-control-sm"
                               placeholder="e.g. Periode: {{date_from}} s/d {{date_to}}  |  Customer: {{customer}}" />
                        <div class="placeholder-hint">Kosongkan kalau tidak perlu sub title.</div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Logo</label>
                        <input type="file" id="el_logo_file" class="form-control form-control-sm" accept=".png,.jpg,.jpeg" />
                        <span id="elLogoStatus" class="placeholder-hint"></span>
                    </div>
                    <div class="col-md-2 d-flex align-items-end gap-1">
                        <img id="el_logo_preview" src="" style="display:none;max-height:40px;max-width:100px;object-fit:contain;border:1px solid #dee2e6;border-radius:4px;padding:2px;" />
                        <button type="button" id="btnRemoveLogo" class="btn btn-sm btn-outline-danger" style="display:none;font-size:.65rem;padding:2px 6px;" title="Hapus logo">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-semibold" style="font-size:.83rem;">
                        <i class="bi bi-layers me-1 text-success"></i>Sheets
                    </span>
                    <button class="btn btn-sm btn-outline-success" id="btnAddSheet">
                        <i class="bi bi-plus-lg me-1"></i>Add Sheet
                    </button>
                </div>
                <div id="elSheetList" class="accordion mb-3"></div>
            </div>

            <div class="pt-2 border-top">
                <button class="btn btn-sm btn-success" id="btnSaveExcelLayout">
                    <i class="bi bi-check-lg me-1"></i>Save Excel Layout
                </button>
                <span id="elSaveStatus" class="ms-2" style="font-size:.75rem;"></span>
            </div>
        </div>
    </div>

    <!-- ════════ TAB 4: PERMISSIONS ════════ -->
    <div class="tab-pane fade" id="tabPermissions">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="fw-semibold" style="font-size:.83rem;">Access Permissions</span>
            <button class="btn btn-sm btn-outline-primary" id="btnAddPerm">
                <i class="bi bi-plus-lg me-1"></i>Add Permission
            </button>
        </div>
        <div class="placeholder-hint mb-3">
            Tentukan role mana yang boleh mengakses report ini.
            Gunakan <code>ALL</code> untuk semua role.
        </div>
        <div id="permList"></div>
    </div>

    <div class="tab-pane fade" id="tabSignature">
        <div class="row g-3 mb-3" style="max-width:400px;">
            <div class="col-12">
                <label class="form-label">Signature Placement</label>
                <select id="sig_placement" class="form-select form-select-sm">
                    <option value="none">None (tidak perlu tanda tangan)</option>
                    <option value="last_page">Last Page Only</option>
                    <option value="every_page">Every Page</option>
                </select>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="fw-semibold" style="font-size:.83rem;">Signature Columns</span>
            <button class="btn btn-sm btn-outline-primary" id="btnAddSignature">
                <i class="bi bi-plus-lg me-1"></i>Add Column
            </button>
        </div>
        <div class="placeholder-hint mb-2">
            Kosongkan list ini kalau report ini tidak butuh tanda tangan.
        </div>
        <div id="signatureList"></div>
    </div>

</div>

<style>
.col-tag {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 8px;
    border-radius: 4px;
    border: 1px solid #dee2e6;
    background: #fff;
    font-size: .72rem;
    cursor: pointer;
    user-select: none;
    transition: background .1s, border-color .1s;
}
.col-tag.active {
    background: #e8f0fe;
    border-color: #4a90e2;
    color: #1a56db;
    font-weight: 600;
}
.col-tag.dragging { opacity: .4; }
.col-tag-drag { font-size:.75rem; color:#aaa; cursor:grab; }
</style>

@section Scripts {
<script>
const reportId   = @Model.Report.ID;
const isNew      = reportId === 0;
const availRoles = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(roles));

let params = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Params));
let perms  = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Permissions));
let signatures = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Signatures ?? new List<TMSBilling.Models.MailReportSignature>()));
let currentLogoPath = '';
let elDirty = false;

function markElDirty() {
    elDirty = true;
    $('#elSaveStatus').html('<span class="text-warning"><i class="bi bi-exclamation-triangle me-1"></i>Ada perubahan belum disimpan</span>');
}

// ══════════════════════════════════════════════
// PARAMS TAB
// ══════════════════════════════════════════════
function renderParams() {
    const c = $('#paramList').empty();
    if (!params.length) {
        c.html('<p class="text-muted" style="font-size:.78rem;">Belum ada parameter. Klik "Add Parameter".</p>');
        return;
    }
    params.forEach((p, i) => c.append(buildParamCard(p, i)));
}

function buildParamCard(p, i) {
    const typeOpts = ['date','text','number','select','multiselect','hidden','daterange']
        .map(t => `<option value="${t}" ${p.param_type===t?'selected':''}>${t}</option>`).join('');
    const srcOpts = ['static','query']
        .map(t => `<option value="${t}" ${p.options_source===t?'selected':''}>${t}</option>`).join('');
    const showOpts = ['select','multiselect'].includes(p.param_type) ? '' : 'display:none;';

    return $(`
        <div class="border rounded mb-2 p-3" style="font-size:.78rem;" data-pi="${i}">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="fw-semibold flex-grow-1 p-lbl-disp">${p.param_label||'Param '+(i+1)}</span>
                <button class="btn btn-outline-secondary p-up"   style="font-size:.6rem;padding:1px 4px;">↑</button>
                <button class="btn btn-outline-secondary p-down" style="font-size:.6rem;padding:1px 4px;">↓</button>
                <button class="btn btn-outline-danger    p-del"  style="font-size:.6rem;padding:1px 5px;">✕</button>
            </div>
            <div class="row g-2 mb-2">
                <div class="col-md-2">
                    <label class="form-label" style="font-size:.7rem;">Key *</label>
                    <input class="form-control form-control-sm font-monospace p-key" value="${p.param_key||''}" placeholder="date_from" />
                    <div class="placeholder-hint">{{placeholder}} di SQL</div>
                </div>
                <div class="col-md-3">
                    <label class="form-label" style="font-size:.7rem;">Label *</label>
                    <input class="form-control form-control-sm p-label" value="${p.param_label||''}" placeholder="e.g. Tanggal Awal" />
                </div>
                <div class="col-md-2">
                    <label class="form-label" style="font-size:.7rem;">Type</label>
                    <select class="form-select form-select-sm p-type">${typeOpts}</select>
                </div>
                <div class="col-md-2">
                    <label class="form-label" style="font-size:.7rem;">Default Value</label>
                    <input class="form-control form-control-sm p-default" value="${p.default_value||''}" placeholder="{{today}}" />
                </div>
                <div class="col-md-1">
                    <label class="form-label" style="font-size:.7rem;">Col Width</label>
                    <input type="number" class="form-control form-control-sm p-colwidth" min="1" max="12" value="${p.col_width||3}" />
                </div>
                <div class="col-md-1">
                    <label class="form-label" style="font-size:.7rem;">Required</label>
                    <div class="form-check form-switch mt-1">
                        <input class="form-check-input p-required" type="checkbox" ${p.is_required===1?'checked':''} />
                    </div>
                </div>
                <div class="col-md-1">
                    <label class="form-label" style="font-size:.7rem;">Hidden</label>
                    <div class="form-check form-switch mt-1">
                        <input class="form-check-input p-hidden" type="checkbox" ${p.is_hidden===1?'checked':''} />
                    </div>
                </div>
            </div>
            <div class="row g-2 p-opts-wrap" style="${showOpts}">
                <div class="col-md-2">
                    <label class="form-label" style="font-size:.7rem;">Options Source</label>
                    <select class="form-select form-select-sm p-opts-src">${srcOpts}</select>
                </div>
                <div class="col-md-5 p-opts-static-wrap" ${p.options_source==='query'?'style="display:none"':''}>
                    <label class="form-label" style="font-size:.7rem;">Options (static)</label>
                    <input class="form-control form-control-sm p-opts-static" value="${p.param_options||''}"
                           placeholder="ACTIVE,INACTIVE  atau  1=Active,2=Inactive" />
                </div>
                <div class="col-md-7 p-opts-query-wrap" ${p.options_source!=='query'?'style="display:none"':''}>
                    <label class="form-label" style="font-size:.7rem;">Options Query</label>
                    <textarea class="form-control form-control-sm query-area p-opts-query" rows="2"
                              placeholder="SELECT id, name FROM tbl ORDER BY name">${p.param_options||''}</textarea>
                </div>
                <div class="col-md-2 p-opts-query-wrap" ${p.options_source!=='query'?'style="display:none"':''}>
                    <label class="form-label" style="font-size:.7rem;">Value Col</label>
                    <input class="form-control form-control-sm p-opts-valcol" value="${p.options_value_col||''}" placeholder="id" />
                </div>
                <div class="col-md-2 p-opts-query-wrap" ${p.options_source!=='query'?'style="display:none"':''}>
                    <label class="form-label" style="font-size:.7rem;">Text Col</label>
                    <input class="form-control form-control-sm p-opts-txtcol" value="${p.options_text_col||''}" placeholder="name" />
                </div>
            </div>
        </div>
    `);
}

$(document).on('change', '.p-type', function () {
    $(this).closest('[data-pi]').find('.p-opts-wrap')
        .toggle(['select','multiselect'].includes($(this).val()));
});
$(document).on('change', '.p-opts-src', function () {
    const isQ = $(this).val() === 'query';
    const c   = $(this).closest('[data-pi]');
    c.find('.p-opts-static-wrap').toggle(!isQ);
    c.find('.p-opts-query-wrap').toggle(isQ);
});
$(document).on('input', '.p-label', function () {
    $(this).closest('[data-pi]').find('.p-lbl-disp').text($(this).val() || 'Param');
});

$('#btnAddParam').on('click', () => {
    collectParams();
    params.push({ param_key:'', param_label:'', param_type:'text', col_width:3,
                  is_required:0, is_hidden:0, options_source:'static' });
    renderParams();
});
$(document).on('click', '.p-del',  function () { const i = $(this).closest('[data-pi]').data('pi'); collectParams(); params.splice(i,1); renderParams(); });
$(document).on('click', '.p-up',   function () { const i = $(this).closest('[data-pi]').data('pi'); collectParams(); if(i>0) [params[i-1],params[i]]=[params[i],params[i-1]]; renderParams(); });
$(document).on('click', '.p-down', function () { const i = $(this).closest('[data-pi]').data('pi'); collectParams(); if(i<params.length-1) [params[i+1],params[i]]=[params[i],params[i+1]]; renderParams(); });

function collectParams() {
    params = [];
    $('#paramList [data-pi]').each(function () {
        const src = $(this).find('.p-opts-src').val();
        params.push({
            param_key:         $(this).find('.p-key').val(),
            param_label:       $(this).find('.p-label').val(),
            param_type:        $(this).find('.p-type').val(),
            default_value:     $(this).find('.p-default').val(),
            col_width:         parseInt($(this).find('.p-colwidth').val()) || 3,
            is_required:       $(this).find('.p-required').is(':checked') ? 1 : 0,
            is_hidden:         $(this).find('.p-hidden').is(':checked') ? 1 : 0,
            options_source:    src,
            param_options:     src==='query' ? $(this).find('.p-opts-query').val() : $(this).find('.p-opts-static').val(),
            options_value_col: $(this).find('.p-opts-valcol').val(),
            options_text_col:  $(this).find('.p-opts-txtcol').val()
        });
    });
}

// ══════════════════════════════════════════════
// PERMISSIONS TAB
// ══════════════════════════════════════════════
function renderPerms() {
    const c = $('#permList').empty();
    if (!perms.length) {
        c.html('<p class="text-muted" style="font-size:.78rem;">Belum ada permission. Report tidak akan bisa diakses user.</p>');
        return;
    }
    perms.forEach((p, i) => {
        const opts = ['ALL', ...availRoles].map(r => `<option value="${r}" ${p.role_name===r?'selected':''}>${r}</option>`).join('');
        c.append($(`
            <div class="d-flex align-items-center gap-2 mb-2" data-prmi="${i}" style="max-width:400px;">
                <select class="form-select form-select-sm prm-role">${opts}</select>
                <button class="btn btn-sm btn-outline-danger prm-del" style="font-size:.68rem;padding:2px 8px;">✕</button>
            </div>
        `));
    });
}
$('#btnAddPerm').on('click', () => { collectPerms(); perms.push({ role_name:'ALL' }); renderPerms(); });
$(document).on('click', '.prm-del', function () {
    const i = $(this).closest('[data-prmi]').data('prmi');
    collectPerms(); perms.splice(i,1); renderPerms();
});
function collectPerms() {
    perms = [];
    $('#permList [data-prmi]').each(function () {
        perms.push({ role_name: $(this).find('.prm-role').val() });
    });
}

// ══════════════════════════════════════════════
// EXCEL LAYOUT TAB
// ══════════════════════════════════════════════
let elData       = { layout: {}, sheets: [] };
let layoutLoaded = false;

$('#tabLayoutBtn').on('shown.bs.tab', async function () {
    if (layoutLoaded) return;
    if (isNew) {
        $('#layoutLoading').hide();
        $('#layoutContent').show();
        onElToggle();
        renderSignatures();
        return;
    }
    try {
        const res = await $.get(`/ReportBuilder/GetLayout?reportId=${reportId}`);
        if (!res.ok) throw new Error(res.message);

        layoutLoaded = true;
        elData = res.data || { layout:{}, sheets:[] };

        const L = elData.layout || {};
        $('#el_use_custom').prop('checked', L.use_custom_layout === 1);
        $('#el_title').val(L.report_title || '');
        $('#el_subtitle').val(L.report_subtitle || '');
        $('#el_title_bg').val('#' + (L.title_bg_color || 'FFFFFF'));
        $('#el_title_fg').val('#' + (L.title_font_color || '000000'));
        $('#el_title_size').val(L.title_font_size || 14);

        currentLogoPath = L.logo_path || '';
        if (currentLogoPath) {
            $('#el_logo_preview').attr('src', currentLogoPath).show();
            $('#btnRemoveLogo').show();   // ← tambah ini
        }

        $('#sig_placement').val(L.signature_placement || 'none');
        signatures = (res.data.signatures || []).slice();
        renderSignatures();

        elRenderSheets();
        onElToggle();
        $('#layoutLoading').hide();
        $('#layoutContent').show();
    } catch(e) {
        $('#layoutLoading').html(`<span class="text-danger"><i class="bi bi-exclamation-circle me-1"></i>${e.message}</span>`);
    }
});

