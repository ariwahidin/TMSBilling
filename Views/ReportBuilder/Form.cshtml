$('#btnSave').on('click', async function () {
    const code = $('#f_code').val().trim();
    const name = $('#f_name').val().trim();
    if (!code || !name) { Swal.fire('Validation','Code & Name wajib diisi.','warning'); return; }

    collectParams();
    collectPerms();

    const outputs = [];
    if ($('#out_excel').is(':checked')) outputs.push('excel');
    if ($('#out_csv').is(':checked'))   outputs.push('csv');
    if ($('#out_pdf').is(':checked')) outputs.push('pdf');

    const vm = {
        report: {
            iD:               reportId,
            report_code:      code,
            report_name:      name,
            report_desc:      $('#f_desc').val(),
            category:         $('#f_cat').val(),
            icon:             $('#f_icon').val(),
            filename_template: $('#f_filename').val(),
            default_output:   $('#f_default_out').val(),
            allowed_outputs:  outputs.join(','),
            is_active:        $('#f_active').is(':checked') ? 1 : 0
        },
        params,
        permissions: perms
    };

    $(this).prop('disabled',true).html('<span class="spinner-border spinner-border-sm"></span>');
    const res = await $.ajax({ url:'/ReportBuilder/Save', method:'POST',
        contentType:'application/json', data: JSON.stringify(vm) });
    $(this).prop('disabled',false).html('<i class="bi bi-check-lg me-1"></i>Save Report');

    if (res.ok) {
        if (isNew) window.location.href = `/ReportBuilder/Form/${res.id}`;
        else Swal.fire({ icon:'success', title:'Saved', timer:1200, showConfirmButton:false });
    } else {
        Swal.fire('Error', res.message, 'error');
    }
});

$(document).on('change input', '#el_use_custom, #el_title, #el_subtitle, #el_title_bg, #el_title_fg, #el_title_size, #sig_placement, .sig-label', markElDirty);

window.addEventListener('beforeunload', function (e) {
    if (elDirty) {
        e.preventDefault();
        e.returnValue = '';
    }
});

// Init
renderParams();
renderPerms();
renderSignatures();
</script>
}
