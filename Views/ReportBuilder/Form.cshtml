function renderSignatures() {
    const c = $('#signatureList').empty();
    if (!signatures.length) {
        c.html('<p class="text-muted" style="font-size:.78rem;">Belum ada kolom tanda tangan.</p>');
        return;
    }
    signatures.forEach((s, i) => c.append(buildSignatureRow(s, i)));
}

function buildSignatureRow(sig, i) {
    return $(`
        <div class="d-flex align-items-center gap-2 mb-2" data-sigi="${i}" style="max-width:500px;">
            <input class="form-control form-control-sm sig-label" value="${elEsc(sig.label||'')}" placeholder="e.g. Pengirim" />
            <button class="btn btn-outline-secondary sig-up" style="font-size:.62rem;padding:2px 6px;">↑</button>
            <button class="btn btn-outline-secondary sig-down" style="font-size:.62rem;padding:2px 6px;">↓</button>
            <button class="btn btn-outline-danger sig-del" style="font-size:.62rem;padding:2px 8px;">✕</button>
        </div>
    `);
}

$('#btnAddSignature').on('click', () => { collectSignatures(); signatures.push({ label: '' }); renderSignatures(); });
$(document).on('click', '.sig-del', function () {
    const i = $(this).closest('[data-sigi]').data('sigi');
    collectSignatures(); signatures.splice(i, 1); renderSignatures();
});
$(document).on('click', '.sig-up', function () {
    const i = $(this).closest('[data-sigi]').data('sigi');
    collectSignatures(); if (i > 0) [signatures[i-1], signatures[i]] = [signatures[i], signatures[i-1]];
    renderSignatures();
});
$(document).on('click', '.sig-down', function () {
    const i = $(this).closest('[data-sigi]').data('sigi');
    collectSignatures(); if (i < signatures.length-1) [signatures[i+1], signatures[i]] = [signatures[i], signatures[i+1]];
    renderSignatures();
});
function collectSignatures() {
    signatures = [];
    $('#signatureList [data-sigi]').each(function () {
        signatures.push({ label: $(this).find('.sig-label').val() });
    });
}

