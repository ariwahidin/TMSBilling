$('#el_logo_file').on('change', async function () {
    const file = this.files[0];
    if (!file) return;
    const fd = new FormData();
    fd.append('file', file);
    $('#elLogoStatus').text('Uploading...');
    try {
        const res = await $.ajax({ url: '/ReportBuilder/UploadLogo', method: 'POST', data: fd, processData: false, contentType: false });
        if (res.ok) {
            currentLogoPath = res.path;
            $('#el_logo_preview').attr('src', res.path).show();
            $('#btnRemoveLogo').show();
            $('#elLogoStatus').text('✓ Uploaded');
            setTimeout(() => $('#elLogoStatus').text(''), 2000);
        } else {
            Swal.fire('Error', res.message, 'error');
            $('#elLogoStatus').text('');
        }
        markElDirty();
    } catch (e) {
        Swal.fire('Error', 'Upload gagal.', 'error');
        $('#elLogoStatus').text('');
    }
});

$('#btnRemoveLogo').on('click', function () {
    currentLogoPath = '';
    $('#el_logo_file').val('');
    $('#el_logo_preview').attr('src', '').hide();
    $('#btnRemoveLogo').hide();
    markElDirty();
    $('#elLogoStatus').text('Logo dihapus (klik Save Excel Layout untuk simpan).');
