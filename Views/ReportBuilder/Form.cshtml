function elMakeTag(col, active, card) {
    const el = document.createElement('div');
    el.className = 'col-tag' + (active ? ' active' : '');
    el.draggable = true;
    el.dataset.col = col;
    el.innerHTML = `<span class="col-tag-drag">⠿</span><span>${col}</span>`;

    // Toggle aktif/nonaktif
    el.addEventListener('click', () => {
        el.classList.toggle('active');
        elSyncCols(card);
    });

    // Drag & drop reorder
    el.addEventListener('dragstart', e => {
        e.dataTransfer.setData('text/plain', col);
        setTimeout(() => el.classList.add('dragging'), 0);
    });
    el.addEventListener('dragend', () => {
        el.classList.remove('dragging');
        elSyncCols(card);
    });
    el.addEventListener('dragover', e => {
        e.preventDefault();
        const dragging = card.find('.el-tags .dragging')[0];
        if (dragging && dragging !== el) {
            const r = el.getBoundingClientRect();
            if (e.clientX > r.left + r.width / 2) {
                el.after(dragging);
            } else {
                el.before(dragging);
            }
        }
    });

    return el;
}
function elSyncCols(card) {
    card.find('.el-sec-cols').val(
        card.find('.el-tags .col-tag.active').map((_,el) => $(el).data('col')).get().join(', ')
    );
}

$(document).on('click', '.el-test', async function () {
    const card = $(this).closest('[data-secidx]');
    const sql  = card.find('.el-sec-query').val();
    const res  = card.find('.el-test-res');
    if (!sql.trim()) { res.show().html('<span class="text-danger">Query kosong.</span>'); return; }
    $(this).prop('disabled',true).html('<span class="spinner-border spinner-border-sm"></span>');
    const data = await $.ajax({ url:'/ReportBuilder/TestQuery', method:'POST',
        contentType:'application/json', data:JSON.stringify({Sql:sql}) });
    $(this).prop('disabled',false).html('<i class="bi bi-play-circle me-1"></i>Test Query');
    if (!data.ok) { res.show().html(`<div class="alert alert-danger py-1 mb-0" style="font-size:.7rem;">${data.message}</div>`); return; }
    const tags = card.find('.el-tags').empty();
    card.find('.col-picker-hint').addClass('hidden');
    const ex = (card.find('.el-sec-cols').val()||'').split(',').map(s=>s.trim()).filter(Boolean);
    data.columns.forEach(col => tags.append(elMakeTag(col, !ex.length||ex.includes(col), card)));
    elSyncCols(card);
    let tbl = `<div style="overflow-x:auto;max-height:150px;"><table class="table table-bordered table-sm mb-0" style="font-size:.68rem;white-space:nowrap;"><thead><tr>`;
    data.columns.forEach(c => tbl += `<th>${c}</th>`);
    tbl += `</tr></thead><tbody>`;
    data.rows.forEach(r => { tbl += '<tr>'; data.columns.forEach(c => tbl += `<td>${r[c]??''}</td>`); tbl += '</tr>'; });
    tbl += `</tbody></table></div>`;
    res.show().html(tbl);
});

