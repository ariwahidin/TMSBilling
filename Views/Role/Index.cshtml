@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    ViewData["Title"] = "Role Management";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Role Management</h4>
    <button class="btn btn-primary btn-sm" onclick="window.location.href='/Role/Create'">
        <i class="fa fa-plus"></i> Add Role
    </button>
</div>

<div class="mb-2">
    <button id="btn-edit" class="btn btn-warning btn-sm" onclick="editRole()">Edit</button>
    <button id="btn-delete" class="btn btn-danger btn-sm" onclick="deleteRole()">Delete</button>
    <button id="btn-permissions" class="btn btn-info btn-sm" onclick="managePermissions()">Manage Permissions</button>
</div>

<div id="role-table"></div>
<form id="tokenForm">@Html.AntiForgeryToken()</form>

@section Styles {
    <link href="https://unpkg.com/tabulator-tables@6.3.1/dist/css/tabulator.min.css" rel="stylesheet">
}

@section Scripts {
    <script src="https://unpkg.com/tabulator-tables@6.3.1/dist/js/tabulator.min.js"></script>
    <script>
        var table = new Tabulator("#role-table", {
            height: 400,
            layout: "fitColumns",
            selectableRows: true,
            pagination: "local",
            paginationSize: 10,
            rowHeader: {
                headerSort: false, resizable: false, frozen: true,
                headerHozAlign: "center", hozAlign: "center",
                formatter: "rowSelection", titleFormatter: "rowSelection", width: 10,
                cellClick: function (e, cell) { cell.getRow().toggleSelect(); }
            },
            columns: [
                { title: "Name", field: "name", width: 200 },
                { title: "Description", field: "description" },
                { title: "Parent Role", field: "parentRoleName", width: 150 }
            ]
        });

        // Load data saat halaman dibuka
        $.get("/Role/GetRoles", function (res) {
            if (res.success) table.setData(res.data);
        });

        function getSelected() {
            const data = table.getSelectedData();
            if (data.length !== 1) {
                showToast("Please select exactly one role.", "error");
                return null;
            }
            return data[0];
        }

        function editRole() {
            const row = getSelected();
            if (row) window.location.href = '/Role/Edit/' + row.id;
        }

        function managePermissions() {
            const row = getSelected();
            if (row) window.location.href = '/Role/Permissions/' + row.id;
        }

        function deleteRole() {
            const row = getSelected();
            if (!row) return;

            if (!confirm(`Delete role "${row.name}"?`)) return;

            fetch('/Role/DeleteAjax', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: row.id })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    showToast(data.message, 'success');
                    $.get("/Role/GetRoles", function (res) {
                        if (res.success) table.setData(res.data);
                    });
                } else {
                    showToast(data.message, 'error');
                }
            });
        }
    </script>
}