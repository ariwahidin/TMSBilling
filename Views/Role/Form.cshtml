@model TMSBilling.Models.Role
@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    var isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Edit Role" : "Create Role";
    var roles = ViewBag.Roles as List<TMSBilling.Models.Role> ?? new();
}

<h4 class="mb-3">@ViewData["Title"]</h4>

<input type="hidden" id="RoleId" value="@Model.Id" />

<div class="form-group mb-3">
    <label>Role Name <span class="text-danger">*</span></label>
    <input type="text" id="Name" class="form-control" value="@Model.Name" />
</div>

<div class="form-group mb-3">
    <label>Description</label>
    <input type="text" id="Description" class="form-control" value="@Model.Description" />
</div>

<div class="form-group mb-3">
    <label>Parent Role <span class="text-muted">(optional)</span></label>
    <select id="ParentRoleId" class="form-control">
        <option value="">-- No Parent --</option>
        @foreach (var role in roles)
        {
            // <option value="@role.Id" @(Model.ParentRoleId == role.Id ? "selected" : "")>
            <option value="@role.Id" selected="@(Model.ParentRoleId == role.Id)">
                @role.Name
            </option>
        }
    </select>
    <small class="text-muted">
        Role ini akan mewarisi semua permission dari parent role yang dipilih.
    </small>
</div>

<button id="btnSave" class="btn btn-primary">Save</button>
<a href="/Role/Index" class="btn btn-secondary">Cancel</a>
<div id="resultMsg" class="mt-3"></div>

@section Scripts {
    <script>
        $("#btnSave").click(function () {
            const id = $("#RoleId").val();
            const isEdit = id && id !== "0";
            const data = {
                Id: parseInt(id) || 0,
                Name: $("#Name").val().trim(),
                Description: $("#Description").val().trim(),
                ParentRoleId: $("#ParentRoleId").val() ? parseInt($("#ParentRoleId").val()) : null
            };

            if (!data.Name) {
                showToast("Role name is required.", "error");
                return;
            }

            $.ajax({
                url: isEdit ? "/Role/EditAjax" : "/Role/CreateAjax",
                method: "POST",
                contentType: "application/json",
                data: JSON.stringify(data),
                success: function (res) {
                    if (res.success) {
                        showToast(res.message, "success");
                        setTimeout(() => window.location.href = '/Role/Index', 600);
                    }
                },
                error: function (xhr) {
                    const res = xhr.responseJSON;
                    showToast(res?.message ?? "An error occurred.", "error");
                }
            });
        });
    </script>
}