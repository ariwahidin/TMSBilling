@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    var role = ViewBag.Role as TMSBilling.Models.Role;
    var allPermissions = ViewBag.AllPermissions as List<TMSBilling.Models.Permission> ?? new();
    var assignedIds = ViewBag.AssignedIds as List<int> ?? new();
    ViewData["Title"] = $"Permissions — {role?.Name}";
}

<h4 class="mb-1">Manage Permissions</h4>
<p class="text-muted mb-3">
    Role: <strong>@role?.Name</strong>
    @if (role?.ParentRoleId != null)
    {
        <span class="ms-2 badge bg-secondary">
            Inherits from parent role automatically
        </span>
    }
</p>

<div class="card">
    <div class="card-body">
        <p class="text-muted small mb-3">
            Centang permission yang dimiliki <strong>langsung</strong> oleh role ini.
            Permission dari parent role akan diwariskan otomatis, tidak perlu dicentang ulang.
        </p>

        <div class="row">
            @foreach (var permission in allPermissions)
            {
                <div class="col-md-4 mb-3">
                    <div class="form-check form-switch">
                        <input class="form-check-input permission-checkbox"
                               type="checkbox"
                               value="@permission.Id"
                               id="perm_@permission.Id"
                               @(assignedIds.Contains(permission.Id) ? "checked" : "") />
                        <label class="form-check-label" for="perm_@permission.Id">
                            <strong>@permission.Name</strong>
                            <br>
                            <small class="text-muted">@permission.Code</small>
                        </label>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<div class="mt-3">
    <button id="btnSave" class="btn btn-primary">Save Permissions</button>
    <a href="/Role/Index" class="btn btn-secondary">Cancel</a>
</div>

@section Scripts {
    <script>
        $("#btnSave").click(function () {
            const permissionIds = [];
            document.querySelectorAll(".permission-checkbox:checked").forEach(cb => {
                permissionIds.push(parseInt(cb.value));
            });

            $.ajax({
                url: "/Role/SavePermissions",
                method: "POST",
                contentType: "application/json",
                data: JSON.stringify({
                    roleId: @role?.Id,
                    permissionIds: permissionIds
                }),
                success: function (res) {
                    if (res.success) {
                        showToast(res.message, "success");
                        setTimeout(() => window.location.href = '/Role/Index', 600);
                    }
                },
                error: function (xhr) {
                    const res = xhr.responseJSON;
                    showToast(res?.message ?? "An error occurred.", "error");
                }
            });
        });
    </script>
}