@model IEnumerable<TMSBilling.Controllers.JobSummaryViewModel>

@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    ViewData["Title"] = "Job List";
}




<div class="mb-3">
    <a href="/Job/Form" class="btn btn-primary btn-sm">
        <i class="bi bi-plus"></i> Create New Job
    </a>
    <button id="btnSyncJob" class="btn btn-info btn-sm">
        <i class="bi bi-check-circle"></i> Sync Job
    </button>
    <button id="btnBulkConfirm" class="btn btn-warning btn-sm" style="display:none;">
        <i class="bi bi-check-circle"></i> POD Selected (<span id="selectedCount">0</span>)
    </button>
</div>

<!-- Filter Date Range - Compact Design -->
<div class="mb-2">
    <div class="card mb-3">
        <div class="card-body py-2">
            <form method="get" action="/Job/Index" class="d-inline-flex align-items-center gap-2">
                <label class="form-label mb-0 text-muted">Delivery Date:</label>
                <input type="date" name="startDate" class="form-control form-control-sm"
                       value="@ViewBag.StartDate" style="width: 130px;" required>
                <span class="text-muted">to</span>
                <input type="date" name="endDate" class="form-control form-control-sm"
                       value="@ViewBag.EndDate" style="width: 130px; font-size: 12px;" required>
                <button type="submit" class="btn btn-secondary btn-sm" style="padding: 2px 10px;">
                    <i class="bi bi-funnel"></i> Filter
                </button>
                <a href="/Job/Index" class="btn btn-outline-secondary btn-sm" style="padding: 2px 10px;">
                    <i class="bi bi-arrow-clockwise"></i> Reset
                </a>
            </form>
        </div>
    </div>
</div>

<table class="table table-sm table-bordered table-hover table-striped align-middle" id="tableJob">
    <thead class="table-light">
        <tr>
            <th><input type="checkbox" id="checkAll" title="Select All"></th>
            <th>#</th>
            <th>Job ID</th>
            <th>Customer</th>
            <th>Status</th>
            <th>Truck ID</th>
            <th>Delivery Date</th>
            <th>Origin</th>
            <th>Destination</th>
            <th>Vendor ID</th>
            <th>Total DO</th>
            <th class="text-center" style="width: 80px;">Action</th>
        </tr>
        <tr>
            <th></th>
            <th></th>
            <th><input type="text" class="form-control form-control-sm" placeholder="Search Job ID"></th>
            <th><input type="text" class="form-control form-control-sm" placeholder="Search Customer"></th>
            <th><input type="text" class="form-control form-control-sm" placeholder="Search Status"></th>
            <th><input type="text" class="form-control form-control-sm" placeholder="Search Truck"></th>
            <th><input type="text" class="form-control form-control-sm" placeholder="Search Date"></th>
            <th><input type="text" class="form-control form-control-sm" placeholder="Search Origin"></th>
            <th><input type="text" class="form-control form-control-sm" placeholder="Search Destination"></th>
            <th><input type="text" class="form-control form-control-sm" placeholder="Search Vendor"></th>
            <th></th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @{
            var i = 1;
            foreach (var item in Model)
            {
                <tr>
                    <td>
                        <input type="checkbox" class="order-checkbox" data-order-id="@item.IdSeq">
                    </td>
                    <td>@i</td>
                    <td>@item.JobId</td>
                    <td>@item.CustomerMain</td>
                    <td>@item.MCStatus</td>
                    <td>@item.TruckNo</td>
                    <td>@item.DelivDate?.ToString("yyyy-MM-dd")</td>
                    <td>@item.Origin</td>
                    <td>@item.Dest</td>
                    <td>@item.VendorPlan</td>
                    <td>@item.TotalDo</td>
                    <td class="text-center">
                        <div class="dropdown">
                            <button class="btn btn-sm btn-link text-dark p-0" type="button"
                                    data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-three-dots-vertical"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                @if (item.IsIntegration == 0)
                                {
                                <li>
                                    <a class="dropdown-item text-success" href="#" onclick="confirmStartJob('@item.JobId'); return false;">
                                        <i class="bi bi-play-circle text-success"></i> Start Job
                                    </a>
                                </li>
                                }

                                @if (item.IsIntegration == 0 && item.MCStatus == "Perjalanan")
                                {
                                    <li>
                                        <a class="dropdown-item text-success" href="#" onclick="confirmClosedJob('@item.JobId'); return false;">
                                            <i class="bi bi-check-circle text-success"></i> Close Job
                                        </a>
                                    </li>
                                }
                                
                                <li>
                                    <a class="dropdown-item" href="/Job/Form/@item.JobId">
                                        <i class="bi bi-pencil-square text-primary"></i> Edit
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item" href="/Job/PrintSPK?jobid=@item.JobId&preview=true" target="_blank">
                                        <i class="bi bi-eye text-primary"></i> Preview SPK
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item" href="/Job/PrintSPK?jobid=@item.JobId" target="_blank">
                                        <i class="bi bi-printer text-success"></i> Print SPK
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item text-danger" href="#" onclick="confirmDelete('@item.JobId'); return false;">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </td>
                </tr>
                i++;
            }
        }
    </tbody>
</table>

<!-- Modal Pilih Mode POD -->
<div class="modal fade" id="modalPodMode" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title">
                    <i class="bi bi-box-seam"></i> Input POD
                </h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body d-grid gap-2">
                <p class="text-muted mb-1" style="font-size:13px;">Select POD input method:</p>
                <button id="btnPodByInvoice" class="btn btn-outline-primary">
                    <i class="bi bi-file-earmark-text"></i> By Order
                </button>
                <button id="btnPodByCnee" class="btn btn-outline-success">
                    <i class="bi bi-geo-alt"></i> By Consignee
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Search ShipTo -->
<div class="modal fade" id="modalShipTo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title">
                    <i class="bi bi-geo-alt"></i> POD by Ship To
                </h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- Filter -->
                <div class="row g-2 mb-3">
                    <div class="col-md-5">
                        <label class="form-label form-label-sm text-muted">Keyword (nama / alamat / kota)</label>
                        <input type="text" id="inputShipToKeyword" class="form-control form-control-sm"
                               placeholder="Cari ship to...">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label form-label-sm text-muted">Delivery Date</label>
                        <input type="date" id="inputShipToDate" class="form-control form-control-sm">
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button id="btnSearchShipTo" class="btn btn-primary btn-sm w-100">
                            <i class="bi bi-search"></i> Search
                        </button>
                    </div>
                </div>

                <!-- Loading -->
                <div id="shipToLoading" style="display:none;" class="text-center py-3">
                    <div class="spinner-border spinner-border-sm text-primary"></div>
                    <span class="ms-2 text-muted">Mencari...</span>
                </div>

                <!-- Empty -->
                <div id="shipToEmpty" style="display:none;" class="text-center py-3 text-muted">
                    <i class="bi bi-inbox fs-4"></i>
                    <p class="mt-1 mb-0">Tidak ada data ditemukan</p>
                </div>

                <!-- Result -->
                <table class="table table-sm table-bordered table-hover align-middle"
                       id="tblShipToResult" style="display:none; font-size:13px;">
                    <thead class="table-dark">
                        <tr>
                            <th style="width:30px;">#</th>
                            <th>Ship To Name</th>
                            <th>Address</th>
                            <th>City</th>
                            <th class="text-center" style="width:65px;">Orders</th>
                            <th class="text-center" style="width:65px;">Action</th>
                        </tr>
                    </thead>
                    <tbody id="shipToResultBody"></tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Tutup</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Delete confirmation
        function confirmDelete(id) {
            Swal.fire({
                icon: 'warning',
                title: 'Are you sure?',
                text: 'This action cannot be undone.',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch(`/Job/Delete/${id}`, { method: 'POST' })
                        .then(res => res.json())
                        .then(data => {
                            if (data.success) {
                                Swal.fire('Deleted!', 'The job has been deleted.', 'success').then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Error', data.message || 'Delete failed.', 'error');
                            }
                        });
                }
            });
        }

        $(document).ready(() => {
            var table = $('#tableJob').DataTable({
                orderCellsTop: true,
                fixedHeader: true,
                pageLength: 25,
                language: { emptyTable: "No jobs available" }
            });

            // Filter per kolom
            $('#tableJob thead tr:eq(1) th').each(function (i) {
                $('input', this).on('keyup change', function () {
                    if (table.column(i).search() !== this.value) {
                        table.column(i).search(this.value).draw();
                    }
                });
            });

            // Sync Job handler
            $('#btnSyncJob').on('click', function () {
                Swal.fire({
                    title: 'Syncing...',
                    text: 'Please wait while we synchronize jobs.',
                    allowOutsideClick: false,
                    didOpen: () => Swal.showLoading()
                });

                $.ajax({
                    url: '/Job/SyncronizeFO',
                    method: 'POST',
                    dataType: 'json',
                    success: function (response) {
                        Swal.close();
                        if (response.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Synchronization Successful',
                                text: response.message,
                                confirmButtonColor: '#3085d6'
                            }).then(() => window.location.reload());
                        } else {
                            Swal.fire('Failed', response.message || 'Synchronization failed.', 'warning');
                        }
                    },
                    error: function (xhr) {
                        Swal.close();
                        Swal.fire('Error', xhr.responseText || 'Server not responding.', 'error');
                    }
                });
            });
        });
    </script>

    <script>
        let selectedOrders = new Set();

        function updateSelectedCount() {
            const count = selectedOrders.size;
            $('#selectedCount').text(count);
            $('#btnBulkConfirm').toggle(count > 0);
        }

        function updateCheckAllStatus() {
            const visibleCheckboxes = $('.order-checkbox:visible');
            const checkedVisible = visibleCheckboxes.filter(':checked').length;

            if (visibleCheckboxes.length === 0) {
                $('#checkAll').prop('checked', false).prop('indeterminate', false);
            } else if (checkedVisible === 0) {
                $('#checkAll').prop('checked', false).prop('indeterminate', false);
            } else if (checkedVisible === visibleCheckboxes.length) {
                $('#checkAll').prop('checked', true).prop('indeterminate', false);
            } else {
                $('#checkAll').prop('checked', false).prop('indeterminate', true);
            }
        }

        // Check All handler
        $('#checkAll').on('change', function() {
            const isChecked = $(this).prop('checked');
            $('.order-checkbox:visible').each(function() {
                const orderId = $(this).data('order-id');
                $(this).prop('checked', isChecked);

                if (isChecked) {
                    selectedOrders.add(orderId);
                } else {
                    selectedOrders.delete(orderId);
                }
            });
            updateSelectedCount();
        });

        // Individual checkbox handler
        $(document).on('change', '.order-checkbox', function() {
            const orderId = $(this).data('order-id');

            if ($(this).prop('checked')) {
                selectedOrders.add(orderId);
            } else {
                selectedOrders.delete(orderId);
            }

            updateSelectedCount();
            updateCheckAllStatus();
        });

        // function bulkConfirmOrders() {
        //     if (selectedOrders.size === 0) {
        //         Swal.fire({
        //             icon: 'warning',
        //             title: 'No Selection',
        //             text: 'Please select at least one order to POD Job.'
        //         });
        //         return;
        //     }

        //     const orderIds = Array.from(selectedOrders);

        //     console.log("Order Selecteds : ", orderIds);

        //     fetch('/Job/BulkJobPod', {
        //         method: 'POST',
        //         headers: {
        //             'Content-Type': 'application/json'
        //         },
        //         body: JSON.stringify(orderIds)
        //     })
        //     .then(res => res.json())
        //     .then(res => {
        //         if (res.success) {
        //             pindah ke halaman edit
        //             window.location.href = res.redirectUrl;
        //         } else {
        //             Swal.fire('Error', res.message, 'error');
        //         }
        //     })
        //     .catch(err => {
        //         console.error(err);
        //         Swal.fire('Error', 'Server error', 'error');
        //     });
        // }


        // Bulk confirm button handler
        // $('#btnBulkConfirm').on('click', bulkConfirmOrders);

                // ── Buka modal pilih mode POD ────────────────────────────────────
        $('#btnBulkConfirm').on('click', function () {
            if (selectedOrders.size === 0) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Tidak ada pilihan',
                    text: 'Pilih minimal satu job terlebih dahulu.'
                });
                return;
            }
            new bootstrap.Modal(document.getElementById('modalPodMode')).show();
        });

        // ── Mode 1: By Invoice No (flow lama) ───────────────────────────
        document.getElementById('btnPodByInvoice').addEventListener('click', function () {
            bootstrap.Modal.getInstance(document.getElementById('modalPodMode')).hide();

            const orderIds = Array.from(selectedOrders);

            fetch('/Job/BulkJobPod', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(orderIds)
            })
            .then(res => res.json())
            .then(res => {
                if (res.success) {
                    window.location.href = res.redirectUrl;
                } else {
                    Swal.fire('Error', res.message, 'error');
                }
            })
            .catch(() => Swal.fire('Error', 'Server error', 'error'));
        });

        // ── Mode 2: By Ship To ───────────────────────────────────────────
        document.getElementById('btnPodByCnee').addEventListener('click', function () {
            bootstrap.Modal.getInstance(document.getElementById('modalPodMode')).hide();

        let orderIds = Array.from(selectedOrders);

        if (orderIds.length === 0) {
            Swal.fire({
                icon: 'warning',
                title: 'No Selection',
                text: 'Please select at least one order to POD Job.'
            });
            return;
        }

        if (orderIds.length > 1) {
            Swal.fire({
                icon: 'warning',
                title: 'Warning',
                text: 'Please select only one Job for Job POD By Consignee.'
            });
            return;
        }

            fetch('/Job/BulkJobPodByCnee', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(orderIds)
            })
            .then(res => res.json())
            .then(res => {
                if (res.success) {
                    window.location.href = res.redirectUrl;
                } else {
                    Swal.fire('Error', res.message, 'error');
                }
            })
            .catch(() => Swal.fire('Error', 'Server error', 'error'));
        });
        // document.getElementById('btnPodByShipTo').addEventListener('click', function () {
        //     bootstrap.Modal.getInstance(document.getElementById('modalPodMode')).hide();

        //     Reset state modal ShipTo
        //     $('#inputShipToKeyword').val('');
        //     $('#inputShipToDate').val(new Date().toISOString().slice(0, 10));
        //     $('#tblShipToResult').hide();
        //     $('#shipToEmpty').hide();
        //     $('#shipToResultBody').empty();

        //     new bootstrap.Modal(document.getElementById('modalShipTo')).show();

        //     Auto search langsung
        //     searchShipTo();
        // });

        // ── Search ShipTo ────────────────────────────────────────────────
        function searchShipTo() {
            const q         = $('#inputShipToKeyword').val().trim();
            const delivDate = $('#inputShipToDate').val();

            $('#shipToLoading').show();
            $('#tblShipToResult').hide();
            $('#shipToEmpty').hide();

            $.ajax({
                url: '/Job/SearchShipTo',
                method: 'GET',
                data: { q, delivDate },
                success: function (res) {
                    $('#shipToLoading').hide();

                    if (!res.success || !res.data || res.data.length === 0) {
                        $('#shipToEmpty').show();
                        return;
                    }

                    const tbody = $('#shipToResultBody');
                    tbody.empty();

                    res.data.forEach((item, idx) => {
                        const firstDate = item.delivery_dates && item.delivery_dates[0]
                            ? item.delivery_dates[0].slice(0, 10)
                            : '';

                        tbody.append(`
                            <tr>
                                <td>${idx + 1}</td>
                                <td>${item.ship_to_name || '-'}</td>
                                <td style="max-width:180px; white-space:normal; font-size:12px;">
                                    ${item.ship_to_address || '-'}
                                </td>
                                <td>${item.ship_to_city || '-'}</td>
                                <td class="text-center">
                                    <span class="badge bg-primary">${item.total_order}</span>
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-success btn-sm py-0 px-2"
                                        onclick="openPodShipTo(
                                            ${JSON.stringify(item.ship_to_name)},
                                            ${JSON.stringify(item.ship_to_address)},
                                            ${JSON.stringify(item.ship_to_city)},
                                            '${firstDate}'
                                        )">
                                        <i class="bi bi-box-arrow-right"></i> Open
                                    </button>
                                </td>
                            </tr>
                        `);
                    });

                    $('#tblShipToResult').show();
                },
                error: function () {
                    $('#shipToLoading').hide();
                    $('#shipToEmpty').show();
                }
            });
        }

        $('#btnSearchShipTo').on('click', searchShipTo);
        $('#inputShipToKeyword').on('keydown', function (e) {
            if (e.key === 'Enter') searchShipTo();
        });

        // ── Open POD by ShipTo ───────────────────────────────────────────
        function openPodShipTo(name, address, city, delivDate) {
            fetch('/Job/OpenPodByShipTo', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    ShipToName:    name,
                    ShipToAddress: address,
                    ShipToCity:    city,
                    DelivDate:     delivDate
                })
            })
            .then(res => res.json())
            .then(res => {
                if (res.success) {
                    window.location.href = res.redirectUrl;
                } else {
                    Swal.fire('Error', res.message || 'Gagal membuka POD', 'error');
                }
            })
            .catch(() => Swal.fire('Error', 'Server error', 'error'));
        }


        
        function confirmStartJob(jobId) {
            Swal.fire({
                icon: 'question',
                title: 'Start Job?',
                text: `Change job ${jobId} status to STARTED?`,
                showCancelButton: true,
                confirmButtonColor: '#28a745',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, Start it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch(`/Job/SetStarted/${jobId}`, { method: 'POST' })
                        .then(res => res.json())
                        .then(data => {
                            if (data.success) {
                                Swal.fire('Started!', 'Job status changed to STARTED.', 'success')
                                    .then(() => location.reload());
                            } else {
                                Swal.fire('Error', data.message || 'Failed to update status.', 'error');
                            }
                        });
                }
            });
        }

        function confirmClosedJob(jobId) {
            Swal.fire({
                icon: 'question',
                title: 'Close Job?',
                text: `Change job ${jobId} status to CLOSED?`,
                showCancelButton: true,
                confirmButtonColor: '#28a745',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, Start it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch(`/Job/SetClosed/${jobId}`, { method: 'POST' })
                        .then(res => res.json())
                        .then(data => {
                            if (data.success) {
                                Swal.fire('Closed!', 'Job status changed to CLOSED.', 'success')
                                    .then(() => location.reload());
                            } else {
                                Swal.fire('Error', data.message || 'Failed to update status.', 'error');
                            }
                        });
                }
            });
        }



    </script>

    <style>
        /* Compact mode */
        #tableJob th, #tableJob td {
            padding: 4px 6px !important;
            font-size: 13px;
        }

        /* Placeholder kecil */
        #tableJob input::placeholder {
            font-size: 11px;
            opacity: 0.7;
        }

        #tableJob input.form-control-sm {
            height: 24px;
            padding: 2px 6px;
        }

        /* Filter date styling - minimalis */
        input[type="date"].form-control-sm {
            height: 26px;
            padding: 2px 6px;
            font-size: 12px;
        }

        /* Dropdown action styling */
        .dropdown-menu {
            min-width: 150px;
            font-size: 13px;
        }

        .dropdown-item {
            padding: 6px 12px;
        }

            .dropdown-item i {
                width: 20px;
                margin-right: 8px;
            }
    </style>
}
