@model TMSBilling.Models.ViewModels.RoutePlanIndexViewModel
@using TMSBilling.Models
@{
    ViewData["Title"] = "Route Planning";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Route Planning</h2>
            <div class="text-muted">Plan and track route execution.</div>
        </div>
        <a asp-action="Form" class="btn btn-primary"><i class="fas fa-plus me-1"></i> Create Route Plan</a>
    </div>

    @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Plan Number</label>
                    <input class="form-control" name="PlanNo" value="@Model.PlanNo" placeholder="Search plan number" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Route Code</label>
                    <input class="form-control" name="RouteCode" value="@Model.RouteCode" placeholder="Search route" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Status</label>
                    <select class="form-select" name="Status">
                        <option value="">All Statuses</option>
                        @foreach (var status in RoutePlanStatuses.All)
                        {
                            <option value="@status" selected="@(Model.Status == status)">@status</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Plan Date From</label>
                    <input type="date" class="form-control" name="StartDate" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Plan Date To</label>
                    <input type="date" class="form-control" name="EndDate" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-12 d-flex gap-2">
                    <button class="btn btn-primary" type="submit"><i class="fas fa-search me-1"></i> Search</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Plan Number</th>
                        <th>Plan Date</th>
                        <th>Route</th>
                        <th>Customer</th>
                        <th>Planned Departure</th>
                        <th>Vehicle / Driver</th>
                        <th class="text-center">Stops</th>
                        <th>Status</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="9" class="text-center text-muted py-5">No route plans found.</td></tr>
                }
                else
                {
                    @foreach (var item in Model.Items)
                    {
                        var badge = item.Status == RoutePlanStatuses.Completed ? "success"
                            : item.Status == RoutePlanStatuses.InProgress ? "primary"
                            : item.Status == RoutePlanStatuses.Confirmed ? "info"
                            : item.Status == RoutePlanStatuses.Cancelled ? "danger" : "secondary";
                        <tr>
                            <td class="fw-semibold">@item.PlanNo</td>
                            <td>@item.PlanDate.ToString("dd MMM yyyy")</td>
                            <td><div class="fw-semibold">@item.RouteCode</div><small class="text-muted">@item.RouteName</small></td>
                            <td>@(item.CustomerCode ?? "—")</td>
                            <td>@(item.PlannedDeparture?.ToString("dd MMM yyyy HH:mm") ?? "—")</td>
                            <td><div>@(item.VehicleNo ?? "—")</div><small class="text-muted">@(item.DriverName ?? "—")</small></td>
                            <td class="text-center">@item.Stops.Count</td>
                            <td><span class="badge text-bg-@badge">@item.Status</span></td>
                            <td class="text-end"><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Open</a></td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
