@model IEnumerable<TMSBilling.Models.FailureType>
@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    ViewData["Title"] = "Failure Type";
    var isAdmin = Context.Session.GetString("is_admin") == "true";
}

<button class="btn btn-primary btn-sm mb-3" id="btnAdd">Add Failure Type</button>
<button class="btn btn-success btn-sm mb-3" id="btnUpload">
    <i class="bi bi-file-earmark-excel"></i> Upload Excel
</button>
<a class="btn btn-outline-secondary btn-sm mb-3" href="/FailureType/DownloadTemplate">
    <i class="bi bi-download"></i> Download Template
</a>

<table class="table table-bordered table-striped" id="failureTypeTable">
    <thead>
        <tr>
            <th>Failure Type Code</th>
            <th>Description</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.failure_type_code</td>
                <td>@item.failure_type_description</td>
                <td>
                    <button class="btn btn-sm btn-warning btnEdit" data-id="@item.id">
                        <i class="bi bi-pencil-square"></i>
                    </button>
                    @if(isAdmin){
                    <button class="btn btn-sm btn-danger btnDelete" data-id="@item.id">
                        <i class="bi bi-trash"></i>
                    </button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Modal -->
<div class="modal fade" id="failureTypeModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Form Failure Type</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalContent"></div>
        </div>
    </div>
</div>

<!-- Upload Modal -->
<div class="modal fade" id="uploadModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Upload Failure Types from Excel</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-2">
                    Use the <a href="/FailureType/DownloadTemplate">template</a> to ensure correct format.
                    Header must be in row 1, data starts from row 2.
                </p>
                <input type="file" id="excelFile" class="form-control" accept=".xlsx,.xls" />
                <div id="uploadLoading" class="mt-2 text-muted" style="display:none;">
                    <span class="spinner-border spinner-border-sm"></span> Processing file...
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-success" id="btnSubmitUpload">Upload</button>
            </div>
        </div>
    </div>
</div>

<!-- Summary Modal -->
<div class="modal fade" id="summaryModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Upload Result</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="summaryContent"></div>
            <div class="modal-footer">
                <button class="btn btn-primary" id="btnCloseSummary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        $(document).ready(function () {

            let uploadModal = new bootstrap.Modal(document.getElementById("uploadModal"));
            let summaryModal = new bootstrap.Modal(document.getElementById("summaryModal"));

            $('#failureTypeTable').DataTable();
            let modal = new bootstrap.Modal(document.getElementById("failureTypeModal"));

            $("#btnAdd").click(function () {
                $.get("/FailureType/Form", function (html) {
                    $("#modalContent").html(html);
                    modal.show();
                });
            });

            $(".btnEdit").click(function () {
                const id = $(this).data("id");
                $.get("/FailureType/Form?id=" + id, function (html) {
                    $("#modalContent").html(html);
                    modal.show();
                });
            });

            $(".btnDelete").click(function () {
                if (!confirm("Yakin hapus data ini?")) return;
                const id = $(this).data("id");

                $.post("/FailureType/Delete", { id }, function () {
                    location.reload();
                }).fail(function (xhr) {
                    const msg = xhr.responseJSON?.message || "Gagal menghapus data.";
                    alert(msg);
                });
            });

            $("#btnUpload").click(function () {
                $("#excelFile").val("");
                uploadModal.show();
            });

            $("#btnSubmitUpload").click(function () {
                const fileInput = document.getElementById("excelFile");
                if (!fileInput.files.length) {
                    alert("Please select an Excel file first.");
                    return;
                }

                const formData = new FormData();
                formData.append("file", fileInput.files[0]);

                $("#uploadLoading").show();
                $("#btnSubmitUpload").prop("disabled", true);

                $.ajax({
                    type: "POST",
                    url: "/FailureType/Upload",
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (res) {
                        uploadModal.hide();
                        renderSummary(res);
                        summaryModal.show();
                    },
                    error: function (xhr) {
                        const msg = xhr.responseJSON?.message || "Failed to upload file.";
                        alert(msg);
                    },
                    complete: function () {
                        $("#uploadLoading").hide();
                        $("#btnSubmitUpload").prop("disabled", false);
                    }
                });
            });

            $("#btnCloseSummary").click(function () {
                location.reload();
            });


            function renderSummary(res) {
                let html = `<div class="mb-3">
                    <span class="badge bg-secondary">Total processed: ${res.totalProcessed}</span>
                    <span class="badge bg-success">Added: ${res.added.length}</span>
                    <span class="badge bg-warning text-dark">Already exists: ${res.skippedExisting.length}</span>
                    <span class="badge bg-info text-dark">Duplicate in file: ${res.skippedDuplicateInFile.length}</span>
                    <span class="badge bg-danger">Invalid: ${res.invalid.length}</span>
                </div>`;

                html += renderList("Successfully added", res.added, "success");
                html += renderList("Skipped (already exists in database)", res.skippedExisting, "warning");
                html += renderList("Skipped (duplicate within file)", res.skippedDuplicateInFile, "info");
                html += renderList("Invalid", res.invalid, "danger");

                $("#summaryContent").html(html);
            }

            function renderList(title, items, colorClass) {
                if (!items || items.length === 0) return "";
                let listItems = items.map(i => `<li>${i}</li>`).join("");
                return `<div class="mb-3">
                    <strong class="text-${colorClass}">${title} (${items.length})</strong>
                    <ul class="mb-0">${listItems}</ul>
                </div>`;
            }


            $(document).on("submit", "#failureTypeForm", function (e) {
                e.preventDefault();
                $.ajax({
                    type: "POST",
                    url: "/FailureType/Form",
                    data: $(this).serialize(),
                    success: function () {
                        modal.hide();
                        location.reload();
                    },
                    error: function (xhr) {
                        const msg = xhr.responseJSON?.message || "Gagal menyimpan data.";
                        alert(msg);
                    }
                });
            });
        });
    </script>
}
