@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    ViewData["Title"] = "Reporting";

    var iframeSrc = ViewBag.IframeSrc as string ?? "";
}

<style>
    .content {
        padding: 0;
    }

    #reportFrame {
        width: 100%;
        min-height: 90vh;
        border: none;
        display: block;
    }

    .report-error {
        margin: 20px;
    }
</style>

@if (!string.IsNullOrWhiteSpace(iframeSrc))
{
    <iframe id="reportFrame"
            src="@iframeSrc"
            title="Reporting"
            loading="eager">
    </iframe>
}
else
{
    <div class="alert alert-danger report-error">
        Reporting URL is not configured.
    </div>
}

@section Scripts
{
}