@model IEnumerable<TMSBilling.Models.MstHoliday>
@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    ViewData["Title"] = "Master Holiday";
    var isAdmin = Context.Session.GetString("is_admin") == "true";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex gap-2">
        <button class="btn btn-primary btn-sm" id="btnAdd">
            <i class="bi bi-plus-lg"></i> Add Holiday
        </button>
        <!-- Bulk toolbar: muncul kalau ada yang dicentang -->
        <div id="bulkToolbar" class="d-none gap-2 d-flex">
            <button class="btn btn-success btn-sm" id="btnBulkActive">
                <i class="bi bi-toggle-on"></i> Set Active
            </button>
            <button class="btn btn-secondary btn-sm" id="btnBulkInactive">
                <i class="bi bi-toggle-off"></i> Set Inactive
            </button>
            @if (isAdmin)
            {
                <button class="btn btn-danger btn-sm" id="btnBulkDelete">
                    <i class="bi bi-trash"></i> Delete Selected
                </button>
            }
            <span class="align-self-center text-muted small" id="selectedCount"></span>
        </div>
    </div>
</div>

<table class="table table-bordered table-striped table-sm" id="holidayTable">
    <thead>
        <tr>
            <th style="width:40px">
                <input type="checkbox" id="checkAll" title="Select All">
            </th>
            <th>Tanggal</th>
            <th>Nama Holiday</th>
            <th>Deskripsi</th>
            <th style="width:80px">Status</th>
            <th style="width:80px">Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="text-center">
                    <input type="checkbox" class="rowCheck" value="@item.IdSeq">
                </td>
                <td>@item.HolDate.ToString("dd MMM yyyy")</td>
                <td>@item.HolName</td>
                <td class="text-muted small">@item.Description</td>
                <td class="text-center">
                    @if (item.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </td>
                <td>
                    <button class="btn btn-sm btn-warning btnEdit" data-id="@item.IdSeq">
                        <i class="bi bi-pencil-square"></i>
                    </button>
                    @if (isAdmin)
                    {
                        <button class="btn btn-sm btn-danger btnDelete" data-id="@item.IdSeq">
                            <i class="bi bi-trash"></i>
                        </button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Modal -->
<div class="modal fade" id="holidayModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Form Holiday</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalContent"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#holidayTable').DataTable({
                order: [[1, 'asc']],
                columnDefs: [
                    { orderable: false, targets: [0, 5] }
                ]
            });

            const modal = new bootstrap.Modal(document.getElementById("holidayModal"));

            // ── Open Form ──
            $("#btnAdd").click(function () {
                $.get("/MstHoliday/Form", html => {
                    $("#modalContent").html(html);
                    modal.show();
                });
            });

            $(document).on("click", ".btnEdit", function () {
                const id = $(this).data("id");
                $.get("/MstHoliday/Form?id=" + id, html => {
                    $("#modalContent").html(html);
                    modal.show();
                });
            });

            // ── Submit Form ──
            $(document).on("submit", "#holidayForm", function (e) {
                e.preventDefault();
                const $btn = $(this).find("button[type=submit]");
                $btn.prop("disabled", true).text("Saving...");

                $.ajax({
                    type: "POST",
                    url: "/MstHoliday/Form",
                    data: $(this).serialize(),
                    success: function () {
                        modal.hide();
                        location.reload();
                    },
                    error: function (xhr) {
                        const msg = xhr.responseJSON?.message ?? "Gagal menyimpan data.";
                        $("#formError").text(msg).removeClass("d-none");
                        $btn.prop("disabled", false).text("Save");
                    }
                });
            });

            // ── Delete single ──
            $(document).on("click", ".btnDelete", function () {
                if (!confirm("Yakin hapus data ini?")) return;
                const id = $(this).data("id");
                $.post("/MstHoliday/Delete", { id }, () => location.reload())
                  .fail(() => alert("Gagal menghapus data."));
            });

            // ── Checkbox logic ──
            function getSelectedIds() {
                return $(".rowCheck:checked").map((_, el) => parseInt(el.value)).get();
            }

            function updateBulkToolbar() {
                const count = $(".rowCheck:checked").length;
                if (count > 0) {
                    $("#bulkToolbar").removeClass("d-none");
                    $("#selectedCount").text(count + " dipilih");
                } else {
                    $("#bulkToolbar").addClass("d-none");
                }
            }

            $("#checkAll").change(function () {
                // DataTables hanya check baris yang visible
                $('#holidayTable').DataTable().$('.rowCheck').prop('checked', this.checked);
                updateBulkToolbar();
            });

            $(document).on("change", ".rowCheck", updateBulkToolbar);

            // ── Bulk Set Active/Inactive ──
            function bulkSetActive(isActive) {
                const ids = getSelectedIds();
                if (!ids.length) return;
                const label = isActive ? "mengaktifkan" : "menonaktifkan";
                if (!confirm(`Yakin ${label} ${ids.length} data?`)) return;

                $.ajax({
                    type: "POST",
                    url: "/MstHoliday/BulkSetActive",
                    contentType: "application/json",
                    data: JSON.stringify({ ids, isActive }),
                    success: () => location.reload(),
                    error: () => alert("Gagal update status.")
                });
            }

            $("#btnBulkActive").click(() => bulkSetActive(true));
            $("#btnBulkInactive").click(() => bulkSetActive(false));

            // ── Bulk Delete ──
            $("#btnBulkDelete").click(function () {
                const ids = getSelectedIds();
                if (!ids.length) return;
                if (!confirm(`Yakin hapus ${ids.length} data?`)) return;

                $.ajax({
                    type: "POST",
                    url: "/MstHoliday/BulkDelete",
                    contentType: "application/json",
                    data: JSON.stringify(ids),
                    success: () => location.reload(),
                    error: () => alert("Gagal menghapus data.")
                });
            });
        });
    </script>
}