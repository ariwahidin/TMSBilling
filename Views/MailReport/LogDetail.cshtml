@model TMSBilling.Models.MailReportLog
@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    ViewData["Title"] = "Log Detail";
}

<style>
    .meta-card {
        background: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 16px;
        font-size: .78rem;
    }

        .meta-card .label {
            color: #6c757d;
            font-weight: 600;
            min-width: 130px;
            display: inline-block;
        }

    .meta-row {
        margin-bottom: 4px;
    }

    .badge-status {
        font-size: .7rem;
        padding: 2px 9px;
        border-radius: 20px;
        font-weight: 600;
    }

    .s-sent {
        background: #d4edda;
        color: #155724;
    }

    .s-failed {
        background: #f8d7da;
        color: #721c24;
    }

    .s-pending {
        background: #fff3cd;
        color: #856404;
    }
</style>

<div class="d-flex align-items-center gap-2 mb-3">
    <h6 style="font-size:.9rem;font-weight:700;margin:0;color:#344767;">
        <i class="bi bi-envelope-open me-1 text-primary"></i>
        Log Detail — #@Model.ID
    </h6>
    <a asp-action="Log" asp-route-reportId="@Model.report_id" class="btn btn-sm btn-outline-secondary ms-auto">
        <i class="bi bi-arrow-left me-1"></i> Back to History
    </a>
</div>

<div class="meta-card">
    <div class="meta-row"><span class="label">Report:</span> @Model.Report?.report_name</div>
    <div class="meta-row">
        <span class="label">Status:</span>
        @{
            var cls = Model.status switch { "SENT" => "s-sent", "FAILED" => "s-failed", _ => "s-pending" };
        }
        <span class="badge-status @cls">@Model.status</span>
    </div>
    <div class="meta-row"><span class="label">Trigger:</span> @Model.trigger_type</div>
    <div class="meta-row"><span class="label">Trigger Ref:</span> <code>@Model.trigger_ref</code></div>
    <div class="meta-row"><span class="label">TO:</span> @Model.recipients_to</div>
    <div class="meta-row"><span class="label">CC:</span> @(string.IsNullOrEmpty(Model.recipients_cc) ? "—" : Model.recipients_cc)</div>
    <div class="meta-row"><span class="label">Subject:</span> @Model.subject_sent</div>
    <div class="meta-row"><span class="label">Sent At:</span> @(Model.sent_at?.ToString("dd MMMM yyyy HH:mm:ss") ?? "Not sent")</div>
    <div class="meta-row"><span class="label">Triggered By:</span> @Model.triggered_by</div>
    <div class="meta-row"><span class="label">Retry Count:</span> @Model.retry_count</div>

    @if (!string.IsNullOrEmpty(Model.error_message))
    {
        <div class="meta-row mt-2">
            <div class="alert alert-danger py-2 mb-0" style="font-size:.75rem;">
                <strong>Error:</strong> @Model.error_message
            </div>
        </div>
    }
</div>

<div class="d-flex align-items-center justify-content-between mb-2">
    <h6 style="font-size:.8rem;font-weight:700;color:#344767;">Email Body Preview</h6>
    @if (Model.status == "FAILED" || Model.status == "PENDING")
    {
        <button class="btn btn-sm btn-warning btnRetrigger" data-id="@Model.ID">
            <i class="bi bi-arrow-repeat me-1"></i> Retrigger
        </button>
    }
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <iframe id="bodyFrame" style="width:100%;min-height:600px;border:none;border-radius:8px;"></iframe>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            // Inject email body into iframe
            const iframe = document.getElementById('bodyFrame');
            const body   = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.body_sent ?? "<p>No body.</p>"));
            iframe.srcdoc = body;

            // Retrigger
            $('.btnRetrigger').click(async function () {
                const confirmed = await Swal.fire({
                    title:'Retrigger this send?', icon:'question', showCancelButton:true,
                    confirmButtonText:'Retrigger', confirmButtonColor:'#0d6efd'
                });
                if (!confirmed.isConfirmed) return;

                const res = await $.post('/MailReport/Retrigger', { logId: $(this).data('id') });
                if (res.ok) {
                    Swal.fire({ title:'Sent!', text:`New log ID: ${res.logId}`, icon:'success', timer:2000, showConfirmButton:false })
                        .then(() => window.location.href = '/MailReport/Log?reportId=@Model.report_id');
                } else {
                    Swal.fire('Failed', res.message, 'error');
                }
            });
        });
    </script>
}
