@model TMSBilling.Models.MailReportFormVM
@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    bool isNew = Model.Report.ID == 0;
    ViewData["Title"] = isNew ? "New Report" : "Edit Report";

    var sectionsJson = System.Text.Json.JsonSerializer.Serialize(Model.Sections);
    var recipientsJson = System.Text.Json.JsonSerializer.Serialize(Model.Recipients);
}

<style>
    .tab-nav .nav-link {
        font-size: .78rem;
        padding: 6px 14px;
        color: #555;
    }

        .tab-nav .nav-link.active {
            font-weight: 600;
            color: #0d6efd;
        }

    .form-label {
        font-size: .76rem;
        font-weight: 600;
        color: #495057;
        margin-bottom: 2px;
    }

    .form-control, .form-select {
        font-size: .81rem;
    }

    .section-card {
        border: 1px solid #e0e7ff;
        border-radius: 8px;
        margin-bottom: 10px;
        background: #fff;
    }

        .section-card .card-header {
            background: #f0f4ff;
            padding: 6px 12px;
            border-radius: 8px 8px 0 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: .78rem;
            font-weight: 600;
        }

        .section-card .card-body {
            padding: 12px;
        }

    .recipient-row {
        background: #f8f9fa;
        border-radius: 6px;
        padding: 8px 10px;
        margin-bottom: 6px;
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: .78rem;
    }

    .badge-type {
        font-size: .68rem;
        padding: 2px 7px;
        border-radius: 10px;
        font-weight: 700;
    }

    .badge-to {
        background: #e8f4fd;
        color: #1a73e8;
    }

    .badge-cc {
        background: #fef3e2;
        color: #e67e00;
    }

    .badge-bcc {
        background: #f0e8fd;
        color: #8b00ff;
    }

    .query-area {
        font-family: monospace;
        font-size: .77rem;
        background: #1e1e1e;
        color: #d4d4d4;
        border: none;
        border-radius: 6px;
        resize: vertical;
    }

    .test-result {
        font-size: .73rem;
    }

    .placeholder-hint {
        font-size: .7rem;
        color: #888;
        margin-top: 3px;
    }

    .save-bar {
        position: sticky;
        bottom: 0;
        background: #fff;
        border-top: 1px solid #eee;
        padding: 8px 0;
        z-index: 10;
    }
    /* Column picker */
    .col-picker-wrap {
        border: 1px solid #dee2e6;
        border-radius: 6px;
        padding: 8px 10px;
        min-height: 38px;
        background: #fafafa;
    }

    .col-picker-hint {
        font-size: .71rem;
        color: #aaa;
        margin-bottom: 6px;
    }

        .col-picker-hint.hidden {
            display: none;
        }

    .col-picker-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
    }

    .col-tag {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3px 8px;
        border-radius: 20px;
        font-size: .72rem;
        cursor: grab;
        user-select: none;
        border: 1px solid #dee2e6;
        background: #fff;
        transition: all .15s;
    }

        .col-tag.active {
            background: #0d6efd;
            color: #fff;
            border-color: #0d6efd;
        }

        .col-tag.dragging {
            opacity: .4;
        }

        .col-tag .col-tag-drag {
            font-size: .65rem;
            opacity: .5;
            cursor: grab;
        }

        .col-tag input[type=checkbox] {
            display: none;
        }
</style>

<!-- Tabs -->
<div class="d-flex align-items-center gap-2 mb-2">
    <h6 style="font-size:.9rem;font-weight:700;margin:0;color:#344767;">
        <i class="bi bi-envelope-paper me-1 text-primary"></i>
        @ViewData["Title"]
    </h6>
    @if (!isNew)
    {
        <code class="text-muted" style="font-size:.73rem;">ID: @Model.Report.ID</code>
    }
</div>

<ul class="nav nav-tabs tab-nav mb-3" id="mainTab">
    <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tabGeneral"><i class="bi bi-gear me-1"></i>General</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tabTemplate"><i class="bi bi-code-square me-1"></i>Template</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tabSections"><i class="bi bi-table me-1"></i>Data Sections</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tabRecipients"><i class="bi bi-people me-1"></i>Recipients</a></li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#tabExcelLayout" id="tabExcelLayoutBtn">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i>Excel Layout
        </a>
    </li>
</ul>

<div class="tab-content" id="mainTabContent">

    <!-- ════════════ TAB 1: GENERAL ════════════ -->
    <div class="tab-pane fade show active" id="tabGeneral">
        <div class="row g-3" style="max-width:700px;">
            <div class="col-md-4">
                <label class="form-label">Report Code <span class="text-danger">*</span></label>
                <input id="f_code" class="form-control form-control-sm text-uppercase"
                       value="@Model.Report.report_code" placeholder="e.g. SPK_NOTICE" maxlength="100"
                       @(isNew ? "" : "readonly") />
                <div class="placeholder-hint">Unique identifier, no spaces.</div>
            </div>
            <div class="col-md-8">
                <label class="form-label">Report Name <span class="text-danger">*</span></label>
                <input id="f_name" class="form-control form-control-sm"
                       value="@Model.Report.report_name" placeholder="e.g. Surat Perintah Kirim" />
            </div>
            <div class="col-12">
                <label class="form-label">Description</label>
                <input id="f_desc" class="form-control form-control-sm"
                       value="@Model.Report.report_desc" placeholder="Optional..." />
            </div>

            <div class="col-md-4">
                <label class="form-label">Trigger Type <span class="text-danger">*</span></label>
                <select id="f_trigger" class="form-select form-select-sm">
                    @if (Model.Report.trigger_type == "MANUAL")
                    {
                        <option value="MANUAL" selected>MANUAL</option>
                    }
                    else
                    {
                        <option value="MANUAL">MANUAL</option>
                    }
                    @if (Model.Report.trigger_type == "EVENT")
                    {
                        <option value="EVENT" selected>EVENT (Realtime)</option>
                    }
                    else
                    {
                        <option value="EVENT">EVENT (Realtime)</option>
                    }
                    @if (Model.Report.trigger_type == "SCHEDULED")
                    {
                        <option value="SCHEDULED" selected>SCHEDULED</option>
                    }
                    else
                    {
                        <option value="SCHEDULED">SCHEDULED</option>
                    }
                </select>
            </div>

            <!-- EVENT fields -->
            <div class="col-md-8" id="eventFields" style="display:none;">
                <label class="form-label">Event Key <span class="text-danger">*</span></label>
                <input id="f_eventkey" class="form-control form-control-sm"
                       value="@Model.Report.event_key"
                       placeholder="e.g. order.created, spk.approved" />
                <div class="placeholder-hint">Must match the key used in <code>TriggerEvent()</code> calls.</div>
            </div>

            <!-- SCHEDULED fields -->
            <div id="schedFields" style="display:none;" class="col-12">
                <div class="row g-2">
                    <div class="col-md-3">
                        <label class="form-label">Frequency</label>
                        <select id="f_freq" class="form-select form-select-sm">
                            @if (Model.Report.schedule_freq == "DAILY")
                            {
                                <option value="DAILY" selected>Daily</option>
                            }
                            else
                            {
                                <option value="DAILY">Daily</option>
                            }
                            @if (Model.Report.schedule_freq == "WEEKLY")
                            {
                                <option value="WEEKLY" selected>Weekly</option>
                            }
                            else
                            {
                                <option value="WEEKLY">Weekly</option>
                            }
                            @if (Model.Report.schedule_freq == "MONTHLY")
                            {
                                <option value="MONTHLY" selected>Monthly</option>
                            }
                            else
                            {
                                <option value="MONTHLY">Monthly</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Send Time</label>
                        <input type="time" id="f_time" class="form-control form-control-sm"
                               value="@(Model.Report.schedule_time?.ToString(@"hh\:mm") ?? "08:00")" />
                    </div>
                    <div class="col-md-3" id="dowField" style="display:none;">
                        <label class="form-label">Day of Week</label>
                        <select id="f_dow" class="form-select form-select-sm">
                            @foreach (var d in new[] { (1, "Monday"), (2, "Tuesday"), (3, "Wednesday"), (4, "Thursday"), (5, "Friday"), (6, "Saturday"), (7, "Sunday") })
                            {
                                @if (Model.Report.schedule_day_of_week == d.Item1)
                                {
                                    <option value="@d.Item1" selected>@d.Item2</option>
                                }
                                else
                                {
                                    <option value="@d.Item1">@d.Item2</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3" id="domField" style="display:none;">
                        <label class="form-label">Day of Month</label>
                        <input type="number" id="f_dom" class="form-control form-control-sm"
                               min="1" max="28" value="@(Model.Report.schedule_day_of_month ?? 1)" />
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <label class="form-label d-block">Status</label>
                <div class="form-check form-switch mt-1">
                    <input class="form-check-input" type="checkbox" id="f_active"
                           @(Model.Report.is_active == 1 || isNew ? "checked" : "") />
                    <label class="form-check-label" for="f_active" style="font-size:.8rem;">Active</label>
                </div>
            </div>
        </div>
    </div>

    <!-- ════════════ TAB 2: TEMPLATE ════════════ -->
    <div class="tab-pane fade" id="tabTemplate">
        <div style="max-width:900px;">
            <div class="mb-3">
                <label class="form-label">Email Subject <span class="text-danger">*</span></label>
                <input id="f_subject" class="form-control form-control-sm"
                       value="@Model.Template.subject"
                       placeholder="e.g. SPK #{{nomor_spk}} - {{vendor_name}}" />
                <div class="placeholder-hint">Use <code>{{field_name}}</code> for dynamic values from query or event params.</div>
            </div>

            <div class="mb-3">
                <label class="form-label">Body Header (HTML)</label>
                <div class="placeholder-hint mb-1">Content above the data tables. Supports <code>{{placeholder}}</code>.</div>
                <textarea id="f_header" class="form-control query-area sec-query" rows="8">@Html.Raw(Model.Template.body_header)</textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">Body Footer (HTML)</label>
                <div class="placeholder-hint mb-1">Content below the data tables (signature, notes, etc.).</div>
                <textarea id="f_footer" class="form-control query-area sec-query" rows="8" >@Html.Raw(Model.Template.body_footer)</textarea>
            </div>

            <div class="row g-3 mt-1">
                <div class="col-md-6">
                    <label class="form-label">Attachments</label>
                    <div class="d-flex gap-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="f_pdf"
                                   @(Model.Template.attach_pdf == 1 ? "checked" : "") />
                            <label class="form-check-label" style="font-size:.8rem;" for="f_pdf">
                                <i class="bi bi-filetype-pdf text-danger me-1"></i> PDF
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="f_excel"
                                   @(Model.Template.attach_excel == 1 ? "checked" : "") />
                            <label class="form-check-label" style="font-size:.8rem;" for="f_excel">
                                <i class="bi bi-filetype-xlsx text-success me-1"></i> Excel
                            </label>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Attachment Filename</label>
                    <input id="f_filename" class="form-control form-control-sm"
                           value="@Model.Template.attach_filename"
                           placeholder="e.g. SPK_{{nomor_spk}}_{{date}}" />
                    <div class="placeholder-hint">Extension (.pdf/.xlsx) added automatically.</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ════════════ TAB 3: DATA SECTIONS ════════════ -->
    <div class="tab-pane fade" id="tabSections">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <span style="font-size:.78rem;color:#555;">Define SQL queries for header, detail, and summary data in the email body.</span>
            <button class="btn btn-sm btn-outline-primary" id="btnAddSection">
                <i class="bi bi-plus-lg me-1"></i> Add Section
            </button>
        </div>
        <div id="sectionList"></div>
    </div>

    <!-- ════════════ TAB 4: RECIPIENTS ════════════ -->
    <div class="tab-pane fade" id="tabRecipients">
        <div class="row g-2 mb-3 align-items-end" style="max-width:700px;">
            <div class="col-md-4">
                <label class="form-label">Source</label>
                <select id="recSource" class="form-select form-select-sm">
                    <option value="TRUCK_EMAIL">From Truck Email</option>
                    <option value="MANUAL">Manual Entry</option>
                </select>
            </div>
            <div class="col-md-5" id="truckEmailPicker">
                <label class="form-label">Select Email</label>
                <select id="recTruckEmail" class="form-select form-select-sm select2">
                    <option value="">-- Select --</option>
                </select>
            </div>
            <div id="manualFields" style="display:none;" class="col-12">
                <div class="row g-2">
                    <div class="col-md-5">
                        <label class="form-label">Email Address</label>
                        <input id="recEmail" class="form-control form-control-sm" type="email" placeholder="email@example.com" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Name</label>
                        <input id="recName" class="form-control form-control-sm" placeholder="Display name" />
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <label class="form-label">Type</label>
                <select id="recType" class="form-select form-select-sm">
                    <option value="TO">TO</option>
                    <option value="CC">CC</option>
                    <option value="BCC">BCC</option>
                </select>
            </div>
            <div class="col-auto">
                <button class="btn btn-sm btn-primary" id="btnAddRecipient">
                    <i class="bi bi-plus-lg"></i> Add
                </button>
            </div>
        </div>

        <div id="recipientList">
            <div class="text-muted" style="font-size:.78rem;" id="emptyRecMsg">No recipients added yet.</div>
        </div>
    </div>

    <!-- ════════════ TAB 5: EXCEL LAYOUT ════════════ -->
    <div class="tab-pane fade" id="tabExcelLayout">

        <div id="elLoading" class="text-muted py-3" style="font-size:.8rem;">
            <span class="spinner-border spinner-border-sm me-1"></span> Loading Excel Layout...
        </div>

        <div id="elContent" style="display:none;">

            <!-- Toggle -->
            <div class="mb-3">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="el_use_custom" />
                    <label class="form-check-label fw-semibold" for="el_use_custom" style="font-size:.83rem;">
                        Use Custom Excel Layout
                    </label>
                </div>
                <div class="placeholder-hint">Aktifkan untuk pakai layout kustom. Nonaktif = pakai Excel builder bawaan.</div>
            </div>

            <div id="elMainConfig" style="display:none;">

                <!-- Report Title -->
                <div class="row g-2 mb-3" style="max-width:900px;">
                    <div class="col-md-5">
                        <label class="form-label">Report Title</label>
                        <input id="el_title" class="form-control form-control-sm"
                               placeholder="e.g. Daily Report Periode {{date}}" />
                        <div class="placeholder-hint">Pojok kiri atas file Excel. Support <code>{{placeholder}}</code>.</div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Title BG</label>
                        <input type="color" id="el_title_bg" class="form-control form-control-sm form-control-color" value="#FFFFFF" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Title Font</label>
                        <input type="color" id="el_title_fg" class="form-control form-control-sm form-control-color" value="#000000" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Font Size</label>
                        <input type="number" id="el_title_size" class="form-control form-control-sm" min="8" max="36" value="14" />
                    </div>
                </div>

                <!-- Sheet List -->
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-semibold" style="font-size:.83rem;color:#344767;">
                        <i class="bi bi-layers me-1 text-success"></i>Sheets
                    </span>
                    <button class="btn btn-sm btn-outline-success" id="btnAddSheet">
                        <i class="bi bi-plus-lg me-1"></i>Add Sheet
                    </button>
                </div>
                <div id="elSheetList" class="accordion mb-3"></div>

            </div>

            <!-- Save Bar -->
            <div class="pt-2 border-top">
                <button class="btn btn-sm btn-success" id="btnSaveExcelLayout">
                    <i class="bi bi-check-lg me-1"></i>Save Excel Layout
                </button>
                <span id="elSaveStatus" class="ms-2" style="font-size:.75rem;"></span>
            </div>
        </div>
    </div>
</div>

<!-- Save Bar -->
<div class="save-bar mt-3">
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
        <button class="btn btn-sm btn-primary" id="btnSave">
            <i class="bi bi-check-lg me-1"></i> Save Report
        </button>
        <span id="saveStatus" class="text-muted align-self-center" style="font-size:.75rem;"></span>
    </div>
</div>

<!-- Section Template (hidden) -->
<div id="sectionTpl" style="display:none;">
    <div class="section-card" data-idx="">
        <div class="card-header">
            <span class="sec-label-display">New Section</span>
            <div class="d-flex gap-1">
                <button class="btn btn-xs btn-outline-secondary btn-moveup" style="font-size:.65rem;padding:1px 5px;" title="Move up">↑</button>
                <button class="btn btn-xs btn-outline-secondary btn-movedown" style="font-size:.65rem;padding:1px 5px;" title="Move down">↓</button>
                <button class="btn btn-xs btn-outline-danger btn-delsec" style="font-size:.65rem;padding:1px 5px;">✕ Remove</button>
            </div>
        </div>
        <div class="card-body">
            <div class="row g-2 mb-2">
                <div class="col-md-3">
                    <label class="form-label">Type</label>
                    <select class="form-select form-select-sm sec-type">
                        <option value="HEADER">HEADER</option>
                        <option value="DETAIL" selected>DETAIL</option>
                        <option value="SUMMARY">SUMMARY</option>
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label">Label</label>
                    <input class="form-control form-control-sm sec-label" placeholder="e.g. Detail Invoice" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Display</label>
                    <select class="form-select form-select-sm sec-display">
                        <option value="TABLE">Table</option>
                        <option value="KEY_VALUE">Key-Value</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">As Placeholder?</label>
                    <div class="form-check form-switch mt-1">
                        <input class="form-check-input sec-placeholder" type="checkbox" />
                        <label class="form-check-label" style="font-size:.75rem;">Yes</label>
                    </div>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Grand Total?</label>
                    <div class="form-check form-switch mt-1">
                        <input class="form-check-input sec-grandtotal" type="checkbox" />
                        <label class="form-check-label" style="font-size:.75rem;">Yes</label>
                    </div>
                </div>
                <div class="col-md-3 sec-grandtotal-label-wrap" style="display:none;">
                    <label class="form-label">Label Total</label>
                    <input class="form-control form-control-sm sec-grandtotal-label" value="Grand Total" />
                </div>
            </div>

            <div class="mb-2">
                <label class="form-label">SQL Query <span class="text-danger">*</span></label>
                <textarea class="form-control query-area sec-query" rows="5"
                          placeholder="SELECT invoice_no, vendor, amount FROM tbl_invoice"></textarea>
                <div class="placeholder-hint">SELECT only. No WHERE needed here — use the WHERE field below.</div>
            </div>

            <div class="mb-2">
                <label class="form-label">WHERE Clause (dynamic)</label>
                <input class="form-control form-control-sm sec-where font-monospace"
                       placeholder="order_id = '{{event.order_id}}' AND status = 'ACTIVE'" style="font-size:.76rem;" />
                <div class="placeholder-hint">Resolved at runtime. Use <code>{{param}}</code> from event params or placeholder sections. Example: <code>a.jobid = '{{order_no}}'</code></div>
            </div>

            <div class="mb-2">
                <label class="form-label">
                    Visible Columns
                    <span class="text-muted fw-normal">(pilih & urutkan dari hasil Test Query)</span>
                </label>
                <!-- Hidden input yang menyimpan nilai akhir -->
                <input type="hidden" class="sec-cols" />
                <!-- Column picker UI -->
                <div class="col-picker-wrap">
                    <div class="col-picker-hint">
                        <i class="bi bi-info-circle me-1"></i>
                        Klik <strong>Test Query</strong> dulu untuk load kolom. Lalu centang kolom yang ingin ditampilkan. Drag untuk ubah urutan.
                    </div>
                    <div class="col-picker-tags"></div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-1">
                <button class="btn btn-xs btn-outline-info btn-test" style="font-size:.72rem;padding:2px 8px;">
                    <i class="bi bi-play-circle me-1"></i> Test Query
                </button>
            </div>
            <div class="test-result mt-2" style="display:none;"></div>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.20/summernote-bs5.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.20/summernote-bs5.min.js"></script>
    <script>

        $(document).ready(function(){

            $('#f_header, #f_footer').summernote({
                height: 280,
                toolbar: [
                    ['style',  ['bold', 'italic', 'underline', 'clear']],
                    ['font',   ['strikethrough']],
                    ['color',  ['color']],
                    ['para',   ['ul', 'ol', 'paragraph']],
                    ['table',  ['table']],
                    ['insert', ['link']],
                    ['view',   ['codeview', 'fullscreen']]
                ],
                placeholder: 'Tulis konten HTML di sini... gunakan {{placeholder}} untuk nilai dinamis.',
                callbacks: {
                    onInit: function () {
                        // remove Summernote branding
                        $(this).next('.note-editor').find('.note-status-output').hide();
                    }
                }
            });

        });

        // ══════════════════════════════════════════════
        // Init Summernote
        // ══════════════════════════════════════════════
        // $('#f_header, #f_footer').summernote({
        //     height: 280,
        //     toolbar: [
        //         ['style',  ['bold', 'italic', 'underline', 'clear']],
        //         ['font',   ['strikethrough']],
        //         ['color',  ['color']],
        //         ['para',   ['ul', 'ol', 'paragraph']],
        //         ['table',  ['table']],
        //         ['insert', ['link']],
        //         ['view',   ['codeview', 'fullscreen']]
        //     ],
        //     placeholder: 'Tulis konten HTML di sini... gunakan {{placeholder}} untuk nilai dinamis.',
        //     callbacks: {
        //         onInit: function () {
        //             remove Summernote branding
        //             $(this).next('.note-editor').find('.note-status-output').hide();
        //         }
        //     }
        // });

        // ══════════════════════════════════════════════
        // State
        // ══════════════════════════════════════════════
        let sections   = @Html.Raw(sectionsJson);
        let recipients = @Html.Raw(recipientsJson);
        let truckEmails = [];

        // ══════════════════════════════════════════════
        // Trigger type toggles
        // ══════════════════════════════════════════════
        function onTriggerChange() {
            const v = $('#f_trigger').val();
            $('#eventFields').toggle(v === 'EVENT');
            $('#schedFields').toggle(v === 'SCHEDULED');
        }
        $('#f_trigger').on('change', onTriggerChange).trigger('change');

        $('#f_freq').on('change', function () {
            $('#dowField').toggle($(this).val() === 'WEEKLY');
            $('#domField').toggle($(this).val() === 'MONTHLY');
        }).trigger('change');

        // ══════════════════════════════════════════════
        // Sections rendering
        // ══════════════════════════════════════════════
        function renderSections() {
            const container = $('#sectionList');
            container.empty();
            if (!sections.length) {
                container.html('<p class="text-muted" style="font-size:.78rem;">No sections yet. Click "Add Section".</p>');
                return;
            }
            sections.forEach((sec, i) => {
                const el = $('#sectionTpl .section-card').first().clone();
                el.attr('data-idx', i);
                el.find('.sec-label-display').text(sec.section_label || 'Section ' + (i+1));
                el.find('.sec-type').val(sec.section_type || 'DETAIL');
                el.find('.sec-label').val(sec.section_label || '');
                el.find('.sec-display').val(sec.display_mode || 'TABLE');
                el.find('.sec-placeholder').prop('checked', sec.use_as_placeholder == 1);
                el.find('.sec-grandtotal').prop('checked', sec.show_grand_total == 1);
                el.find('.sec-grandtotal-label').val(sec.grand_total_label || 'Grand Total');
                el.find('.sec-grandtotal-label-wrap').toggle(sec.show_grand_total == 1);
                el.find('.sec-query').val(sec.sql_query || '');
                el.find('.sec-where').val(sec.sql_where || '');
                el.find('.sec-cols').val(sec.visible_columns || '');

                // Restore saved visible columns as tags
                if (sec.visible_columns) {
                    const picker = el.find('.col-picker-tags');
                    const hint   = el.find('.col-picker-hint');
                    hint.addClass('hidden');
                    sec.visible_columns.split(',').map(s => s.trim()).filter(Boolean).forEach(col => {
                        const tag = $(`<div class="col-tag active" draggable="true" data-col="${col}"><span class="col-tag-drag">⠿</span><span>${col}</span></div>`);
                        tag.on('click', function () { $(this).toggleClass('active'); syncColPicker(el); });
                        picker.append(tag);
                    });
                }
                el.find('.test-result').hide().empty();
                container.append(el);
            });
        }

        function collectSections() {
            sections = [];
            $('#sectionList .section-card').each(function (i) {
                sections.push({
                    section_type:       $(this).find('.sec-type').val(),
                    section_label:      $(this).find('.sec-label').val(),
                    display_mode:       $(this).find('.sec-display').val(),
                    use_as_placeholder: $(this).find('.sec-placeholder').is(':checked') ? 1 : 0,
                    show_grand_total:   $(this).find('.sec-grandtotal').is(':checked') ? 1 : 0,
                    grand_total_label:  $(this).find('.sec-grandtotal-label').val() || 'Grand Total',
                    sql_query:          $(this).find('.sec-query').val(),
                    sql_where:          $(this).find('.sec-where').val(),
                    visible_columns:    $(this).find('.sec-cols').val(),
                    sort_order: i
                });
            });
        }

        $('#btnAddSection').click(function () {
            collectSections();
            sections.push({ section_type:'DETAIL', section_label:'New Section', display_mode:'TABLE',
                            sql_query:'', sql_where:'', visible_columns:'', use_as_placeholder:0, sort_order: sections.length });
            renderSections();
        });

        $(document).on('click', '.btn-delsec', function () {
            const i = $(this).closest('.section-card').data('idx');
            collectSections(); sections.splice(i, 1); renderSections();
        });

        $(document).on('click', '.btn-moveup', function () {
            collectSections();
            const i = $(this).closest('.section-card').data('idx');
            if (i > 0) { [sections[i-1], sections[i]] = [sections[i], sections[i-1]]; renderSections(); }
        });

        $(document).on('click', '.btn-movedown', function () {
            collectSections();
            const i = $(this).closest('.section-card').data('idx');
            if (i < sections.length - 1) { [sections[i+1], sections[i]] = [sections[i], sections[i+1]]; renderSections(); }
        });

        // Update label display on type
        $(document).on('input', '.sec-label', function () {
            $(this).closest('.section-card').find('.sec-label-display').text($(this).val() || 'Section');
        });

        // Toggle Grand Total label field
        $(document).on('change', '.sec-grandtotal', function () {
            $(this).closest('.section-card')
                .find('.sec-grandtotal-label-wrap')
                .toggle($(this).is(':checked'));
        });

        // Test query + populate column picker
        $(document).on('click', '.btn-test', async function () {
            const card = $(this).closest('.section-card');
            const sql  = card.find('.sec-query').val();
            const res  = card.find('.test-result');

            if (!sql.trim()) { res.show().html('<span class="text-danger">Query is empty.</span>'); return; }

            $(this).prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span>');

            const data = await $.ajax({ url:'/MailReport/TestQuery', method:'POST',
                contentType:'application/json',
                data: JSON.stringify({ Sql: sql }) });

            $(this).prop('disabled', false).html('<i class="bi bi-play-circle me-1"></i> Test Query');

            if (!data.ok) {
                res.show().html(`<div class="alert alert-danger py-1 mb-0" style="font-size:.72rem;">${data.message}</div>`);
                return;
            }

            // ── Populate column picker ──
            const picker   = card.find('.col-picker-tags');
            const hint     = card.find('.col-picker-hint');
            const hiddenIn = card.find('.sec-cols');
            const existing = hiddenIn.val() ? hiddenIn.val().split(',').map(s => s.trim()) : [];

            picker.empty();
            hint.addClass('hidden');

            data.columns.forEach(col => {
                const isActive = existing.length === 0 || existing.includes(col);
                const tag = $(`
                    <div class="col-tag ${isActive ? 'active' : ''}" draggable="true" data-col="${col}">
                        <span class="col-tag-drag">⠿</span>
                        <span>${col}</span>
                    </div>
                `);
                tag.on('click', function () {
                    $(this).toggleClass('active');
                    syncColPicker(card);
                });
                // Drag to reorder
                tag[0].addEventListener('dragstart', e => {
                    e.dataTransfer.setData('text/plain', col);
                    tag.addClass('dragging');
                });
                tag[0].addEventListener('dragend', () => {
                    tag.removeClass('dragging');
                    syncColPicker(card);
                });
                tag[0].addEventListener('dragover', e => {
                    e.preventDefault();
                    const dragging = picker.find('.dragging');
                    if (dragging.length && dragging[0] !== tag[0]) {
                        const rect   = tag[0].getBoundingClientRect();
                        const after  = e.clientX > rect.left + rect.width / 2;
                        after ? tag.after(dragging) : tag.before(dragging);
                    }
                });
                picker.append(tag);
            });

            syncColPicker(card);

            // ── Show data preview ──
            let tbl = `<div style="overflow-x:auto;max-height:180px;margin-top:8px;"><table class="table table-bordered table-sm mb-0" style="font-size:.71rem;white-space:nowrap;"><thead><tr>`;
            data.columns.forEach(c => tbl += `<th>${c}</th>`);
            tbl += `</tr></thead><tbody>`;
            data.rows.forEach(r => {
                tbl += '<tr>';
                data.columns.forEach(c => tbl += `<td>${r[c] ?? ''}</td>`);
                tbl += '</tr>';
            });
            tbl += `</tbody></table></div>`;
            res.show().html(tbl);
        });

        function syncColPicker(card) {
            const selected = card.find('.col-picker-tags .col-tag.active')
                .map((_, el) => $(el).data('col')).get();
            card.find('.sec-cols').val(selected.join(', '));
        }

        renderSections();

        // ══════════════════════════════════════════════
        // Recipients
        // ══════════════════════════════════════════════
        async function loadTruckEmails() {
            truckEmails = await $.get('/MailReport/GetTruckEmails');
            const sel = $('#recTruckEmail');
            sel.empty().append('<option value="">-- Select Email --</option>');
            truckEmails.forEach(e => {
                const supCode   = e.sup_code   ?? e.supCode   ?? '';
                const vehicleNo = e.vehicle_no ?? e.vehicleNo ?? '';
                const email     = e.email_address ?? e.emailAddress ?? '';
                const type      = e.email_type    ?? e.emailType    ?? '';
                sel.append(`<option value="${e.id}">${supCode} | ${vehicleNo} | ${email} (${type})</option>`);
            });
            sel.trigger('change');
        }

        $('#recSource').on('change', function () {
            const isManual = $(this).val() === 'MANUAL';
            $('#truckEmailPicker').toggle(!isManual);
            $('#manualFields').toggle(isManual);
        }).trigger('change');

        $('#btnAddRecipient').click(function () {
            const source = $('#recSource').val();
            const type   = $('#recType').val();

            if (source === 'TRUCK_EMAIL') {
                const id  = parseInt($('#recTruckEmail').val());
                const te  = truckEmails.find(e => e.id === id);
                if (!te) { Swal.fire('Warning','Please select an email.','warning'); return; }
                recipients.push({ recipient_source:'TRUCK_EMAIL', truck_email_id: id,
                    email_address: te.email_address ?? te.emailAddress,
                    email_name:    te.email_name    ?? te.emailName ?? '',
                    email_type: type, is_active: 1 });
            } else {
                const email = $('#recEmail').val().trim();
                const name  = $('#recName').val().trim();
                if (!email) { Swal.fire('Warning','Email address is required.','warning'); return; }
                recipients.push({ recipient_source:'MANUAL', truck_email_id: null,
                    email_address: email, email_name: name,
                    email_type: type, is_active: 1 });
            }
            renderRecipients();
        });

        function renderRecipients() {
            const c = $('#recipientList');
            c.empty();
            if (!recipients.length) { c.html('<div class="text-muted" style="font-size:.78rem;">No recipients added yet.</div>'); return; }
            recipients.forEach((r, i) => {
                const badge = r.email_type === 'TO' ? 'badge-to' : r.email_type === 'CC' ? 'badge-cc' : 'badge-bcc';
                c.append(`<div class="recipient-row">
                    <span class="badge-type ${badge}">${r.email_type}</span>
                    <span style="flex:1;">
                        ${r.email_name ? `<strong>${r.email_name}</strong> — ` : ''}
                        ${r.email_address}
                        ${r.recipient_source === 'TRUCK_EMAIL' ? '<span class="text-muted ms-1" style="font-size:.68rem;">(Truck Email)</span>' : ''}
                    </span>
                    <button class="btn btn-xs btn-outline-danger btn-delrec" style="font-size:.65rem;padding:1px 5px;" data-i="${i}">✕</button>
                </div>`);
            });
        }

        $(document).on('click', '.btn-delrec', function () {
            recipients.splice($(this).data('i'), 1); renderRecipients();
        });

        renderRecipients();
        loadTruckEmails();

        // ══════════════════════════════════════════════
        // SAVE
        // ══════════════════════════════════════════════
        $('#btnSave').click(async function () {
            collectSections();

            // Sync Summernote
            const header = $('#f_header').summernote('code') ?? '';
            const footer = $('#f_footer').summernote('code') ?? '';

            const trigger = $('#f_trigger').val();
            const payload = {
                Report: {
                    ID:                   @Model.Report.ID,
                    report_code:          $('#f_code').val().trim().toUpperCase(),
                    report_name:          $('#f_name').val().trim(),
                    report_desc:          $('#f_desc').val().trim(),
                    trigger_type:         trigger,
                    event_key:            $('#f_eventkey').val().trim(),
                    schedule_freq:        $('#f_freq').val(),
                    schedule_time:        trigger === 'SCHEDULED' ? $('#f_time').val() + ':00' : null,
                    schedule_day_of_week: trigger === 'SCHEDULED' && $('#f_freq').val() === 'WEEKLY' ? parseInt($('#f_dow').val()) : null,
                    schedule_day_of_month: trigger === 'SCHEDULED' && $('#f_freq').val() === 'MONTHLY' ? parseInt($('#f_dom').val()) : null,
                    is_active:            $('#f_active').is(':checked') ? 1 : 0
                },
                Template: {
                    subject:         $('#f_subject').val().trim(),
                    body_header:     header,
                    body_footer:     footer,
                    attach_pdf:      $('#f_pdf').is(':checked') ? 1 : 0,
                    attach_excel:    $('#f_excel').is(':checked') ? 1 : 0,
                    attach_filename: $('#f_filename').val().trim()
                },
                Sections: sections,
                Recipients: recipients
            };

            if (!payload.Report.report_code || !payload.Report.report_name || !payload.Template.subject) {
                Swal.fire('Validation', 'Report Code, Name, and Subject are required.', 'warning'); return;
            }

            $(this).prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span> Saving...');
            $('#saveStatus').text('');

            const res = await $.ajax({ url:'/MailReport/Save', method:'POST',
                contentType:'application/json', data: JSON.stringify(payload) });

            $(this).prop('disabled', false).html('<i class="bi bi-check-lg me-1"></i> Save Report');

            if (res.ok) {
                Swal.fire({ title:'Saved!', icon:'success', timer:1500, showConfirmButton:false })
                    .then(() => window.location.href = '/MailReport/Index');
            } else {
                Swal.fire('Error', res.message, 'error');
            }
        });
    </script>
    <script>
        // ══════════════════════════════════════════════
        // Excel Layout — State & Init
        // ══════════════════════════════════════════════
        let elData  = { layout: {}, sheets: [] };
        let elLoaded = false;
        const _reportId = @Model.Report.ID;

        // Lazy load saat tab diklik
        $('#tabExcelLayoutBtn').on('shown.bs.tab', async function () {
            if (elLoaded) return;
            if (_reportId === 0) {
                $('#elLoading').hide();
                $('#elContent').show();
                onElToggle();
                return;
            }
            await elLoad();
        });

        async function elLoad() {
            const res = await $.get(`/MailReport/GetExcelLayout?reportId=${_reportId}`);
            if (!res.ok) {
                $('#elLoading').html(`<span class="text-danger">${res.message}</span>`);
                return;
            }
            elData   = res.data;
            elLoaded = true;

            const L = elData.layout || {};
            $('#el_use_custom').prop('checked', L.use_custom_layout === 1);
            $('#el_title').val(L.report_title || '');
            $('#el_title_bg').val('#' + (L.title_bg_color || 'FFFFFF'));
            $('#el_title_fg').val('#' + (L.title_font_color || '000000'));
            $('#el_title_size').val(L.title_font_size || 14);

            elRenderSheets();
            onElToggle();
            $('#elLoading').hide();
            $('#elContent').show();
        }

        $('#el_use_custom').on('change', onElToggle);
        function onElToggle() {
            $('#elMainConfig').toggle($('#el_use_custom').is(':checked'));
        }

        // ══════════════════════════════════════════════
        // Sheet Management
        // ══════════════════════════════════════════════
        function elRenderSheets() {
            const c = $('#elSheetList').empty();
            if (!elData.sheets?.length) {
                c.html('<p class="text-muted" style="font-size:.77rem;">Belum ada sheet. Klik "Add Sheet".</p>');
                return;
            }
            elData.sheets.forEach((sv, si) => {
                c.append(elBuildSheetCard(sv, si));
            });
        }

        function elBuildSheetCard(sv, si) {
            const cid  = `elSheet_${si}`;
            const name = elEsc(sv.sheet?.sheet_name || `Sheet ${si+1}`);
            const card = $(`
                <div class="accordion-item border mb-2 rounded" data-si="${si}">
                    <div class="accordion-header d-flex align-items-center px-3 py-2 rounded-top gap-2"
                         style="background:#f0f4ff;">
                        <button class="accordion-button collapsed p-0 bg-transparent border-0 shadow-none flex-grow-1"
                                type="button" data-bs-toggle="collapse" data-bs-target="#${cid}"
                                style="font-size:.8rem;font-weight:600;">
                            <i class="bi bi-table me-2 text-success"></i>
                            <span class="el-sheet-label">${name}</span>
                        </button>
                        <button class="btn btn-outline-danger el-del-sheet"
                                style="font-size:.62rem;padding:1px 6px;">✕</button>
                    </div>
                    <div class="accordion-collapse collapse" id="${cid}">
                        <div class="accordion-body pt-2 pb-3 px-3">
                            <div class="row g-2 mb-2">
                                <div class="col-md-5">
                                    <label class="form-label">Sheet Name</label>
                                    <input class="form-control form-control-sm el-sheet-name"
                                           value="${name}" placeholder="e.g. Summary, Detail {{date}}" />
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span style="font-size:.75rem;color:#555;font-weight:600;">Sections</span>
                                <button class="btn el-add-section"
                                        style="font-size:.68rem;padding:2px 8px;border:1px solid #6c757d;border-radius:4px;">
                                    <i class="bi bi-plus-lg"></i> Add Section
                                </button>
                            </div>
                            <div class="el-section-list"></div>
                        </div>
                    </div>
                </div>
            `);

            const secList = card.find('.el-section-list');
            (sv.sections || []).forEach((sec, secIdx) => {
                secList.append(elBuildSecCard(sec, si, secIdx));
            });

            if (!sv.sections?.length)
                secList.html('<p class="text-muted" style="font-size:.73rem;">Belum ada section.</p>');

            return card;
        }

        function elBuildSecCard(sec, si, secIdx) {
            const layoutOpts  = ['vertical','side_by_side']
                .map(v => `<option value="${v}" ${sec.layout===v?'selected':''}>${v}</option>`).join('');
            const displayOpts = ['TABLE','KEY_VALUE']
                .map(v => `<option value="${v}" ${sec.display_mode===v?'selected':''}>${v}</option>`).join('');
            const gtShow = sec.show_grand_total === 1 ? '' : 'display:none;';

            const card = $(`
                <div class="border rounded mb-2 p-2" style="font-size:.77rem;" data-secidx="${secIdx}">
                    <div class="d-flex align-items-center gap-1 mb-2">
                        <span class="fw-semibold flex-grow-1 el-sec-lbl-disp">${elEsc(sec.section_label)||'Section '+(secIdx+1)}</span>
                        <button class="btn btn-outline-secondary el-sec-up"   style="font-size:.58rem;padding:1px 4px;">↑</button>
                        <button class="btn btn-outline-secondary el-sec-down" style="font-size:.58rem;padding:1px 4px;">↓</button>
                        <button class="btn btn-outline-danger    el-sec-del"  style="font-size:.58rem;padding:1px 5px;">✕</button>
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-md-3"><label class="form-label" style="font-size:.7rem;">Label</label>
                            <input class="form-control form-control-sm el-sec-label" value="${elEsc(sec.section_label)}" /></div>
                        <div class="col-md-2"><label class="form-label" style="font-size:.7rem;">Layout</label>
                            <select class="form-select form-select-sm el-sec-layout">${layoutOpts}</select></div>
                        <div class="col-md-1"><label class="form-label" style="font-size:.7rem;">Group</label>
                            <input type="number" class="form-control form-control-sm el-sec-group" min="0" value="${sec.group_id||0}" /></div>
                        <div class="col-md-1"><label class="form-label" style="font-size:.7rem;">SideGap</label>
                            <input type="number" class="form-control form-control-sm el-sec-sidegap" min="0" value="${sec.side_gap??1}" /></div>
                        <div class="col-md-1"><label class="form-label" style="font-size:.7rem;">BotGap</label>
                            <input type="number" class="form-control form-control-sm el-sec-botgap" min="0" value="${sec.bottom_gap??2}" /></div>
                        <div class="col-md-2"><label class="form-label" style="font-size:.7rem;">Display</label>
                            <select class="form-select form-select-sm el-sec-display">${displayOpts}</select></div>
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-md-4"><label class="form-label" style="font-size:.7rem;">Section Title</label>
                            <input class="form-control form-control-sm el-sec-title" value="${elEsc(sec.section_title)}"
                                   placeholder="e.g. Delivery Dashboard : {{date}}" /></div>
                        <div class="col-md-2"><label class="form-label" style="font-size:.7rem;">Title BG</label>
                            <input type="color" class="form-control form-control-sm form-control-color el-sec-titlebg"
                                   value="#${sec.title_bg_color||'FFD700'}" /></div>
                        <div class="col-md-2"><label class="form-label" style="font-size:.7rem;">Title Font</label>
                            <input type="color" class="form-control form-control-sm form-control-color el-sec-titlefg"
                                   value="#${sec.title_font_color||'000000'}" /></div>
                        <div class="col-md-2"><label class="form-label" style="font-size:.7rem;">Header BG</label>
                            <input type="color" class="form-control form-control-sm form-control-color el-sec-headerbg"
                                   value="#${sec.header_bg_color||'FFD700'}" /></div>
                        <div class="col-md-2"><label class="form-label" style="font-size:.7rem;">Header Font</label>
                            <input type="color" class="form-control form-control-sm form-control-color el-sec-headerfg"
                                   value="#${sec.header_font_color||'000000'}" /></div>
                    </div>

                    <div class="row g-2 mb-2 align-items-center">
                        <div class="col-auto">
                            <div class="form-check form-switch">
                                <input class="form-check-input el-sec-gt" type="checkbox"
                                       ${sec.show_grand_total===1?'checked':''} />
                                <label class="form-check-label" style="font-size:.75rem;">Grand Total</label>
                            </div>
                        </div>
                        <div class="col-md-2 el-gt-wrap" style="${gtShow}">
                            <input class="form-control form-control-sm el-sec-gt-label"
                                   value="${elEsc(sec.grand_total_label)||'TOTAL'}" placeholder="Label total" /></div>
                        <div class="col-md-2 el-gt-wrap" style="${gtShow}">
                            <input type="color" class="form-control form-control-sm form-control-color el-sec-totalbg"
                                   value="#${sec.total_bg_color||'FFD700'}" /></div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label" style="font-size:.7rem;">SQL Query <span class="text-danger">*</span></label>
                        <textarea class="form-control query-area el-sec-query" rows="4"
                                  placeholder="SELECT col1, col2 FROM tbl_xxx">${elEsc(sec.sql_query)}</textarea>
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-md-5">
                            <label class="form-label" style="font-size:.7rem;">WHERE Clause</label>
                            <input class="form-control form-control-sm el-sec-where font-monospace"
                                   value="${elEsc(sec.sql_where)}"
                                   placeholder="col = '{{param}}'" style="font-size:.75rem;" /></div>
                        <div class="col-md-7">
                            <label class="form-label" style="font-size:.7rem;">Visible Columns</label>
                            <input type="hidden" class="el-sec-cols" value="${elEsc(sec.visible_columns)}" />
                            <div class="col-picker-wrap">
                                <div class="col-picker-hint ${sec.visible_columns?'hidden':''}">
                                    <i class="bi bi-info-circle me-1"></i>Klik Test Query untuk load kolom.
                                </div>
                                <div class="col-picker-tags el-tags"></div>
                            </div>
                        </div>
                    </div>

                    <div>
                        <button class="btn btn-outline-info el-test" style="font-size:.7rem;padding:2px 8px;">
                            <i class="bi bi-play-circle me-1"></i>Test Query
                        </button>
                    </div>
                    <div class="el-test-res mt-2" style="display:none;"></div>
                </div>
            `);

            // Restore saved columns
            if (sec.visible_columns) {
                const tags = card.find('.el-tags');
                card.find('.col-picker-hint').addClass('hidden');
                sec.visible_columns.split(',').map(s=>s.trim()).filter(Boolean).forEach(col => {
                    tags.append(elMakeTag(col, true, card));
                });
            }

            return card;
        }

        // ── Tag helpers ──
        function elMakeTag(col, active, card) {
            const tag = $(`<div class="col-tag ${active?'active':''}" draggable="true" data-col="${col}">
                <span class="col-tag-drag">⠿</span><span>${col}</span></div>`);
            tag.on('click', () => { tag.toggleClass('active'); elSyncCols(card); });
            tag[0].addEventListener('dragstart', e => { e.dataTransfer.setData('text', col); tag.addClass('dragging'); });
            tag[0].addEventListener('dragend', () => { tag.removeClass('dragging'); elSyncCols(card); });
            tag[0].addEventListener('dragover', e => {
                e.preventDefault();
                const dr = card.find('.el-tags .dragging');
                if (dr.length && dr[0] !== tag[0]) {
                    const r = tag[0].getBoundingClientRect();
                    e.clientX > r.left + r.width/2 ? tag.after(dr) : tag.before(dr);
                }
            });
            return tag;
        }

        function elSyncCols(card) {
            const sel = card.find('.el-tags .col-tag.active').map((_,el) => $(el).data('col')).get();
            card.find('.el-sec-cols').val(sel.join(', '));
        }

        // ── Test Query ──
        $(document).on('click', '.el-test', async function () {
            const card = $(this).closest('[data-secidx]');
            const sql  = card.find('.el-sec-query').val();
            const res  = card.find('.el-test-res');
            if (!sql.trim()) { res.show().html('<span class="text-danger">Query kosong.</span>'); return; }

            $(this).prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span>');
            const data = await $.ajax({ url:'/MailReport/TestQuery', method:'POST',
                contentType:'application/json', data: JSON.stringify({ Sql: sql }) });
            $(this).prop('disabled', false).html('<i class="bi bi-play-circle me-1"></i>Test Query');

            if (!data.ok) { res.show().html(`<div class="alert alert-danger py-1 mb-0" style="font-size:.7rem;">${data.message}</div>`); return; }

            const tags = card.find('.el-tags').empty();
            card.find('.col-picker-hint').addClass('hidden');
            const existing = (card.find('.el-sec-cols').val() || '').split(',').map(s=>s.trim()).filter(Boolean);
            data.columns.forEach(col => {
                tags.append(elMakeTag(col, !existing.length || existing.includes(col), card));
            });
            elSyncCols(card);

            let tbl = `<div style="overflow-x:auto;max-height:150px;">
                <table class="table table-bordered table-sm mb-0" style="font-size:.68rem;white-space:nowrap;"><thead><tr>`;
            data.columns.forEach(c => tbl += `<th>${c}</th>`);
            tbl += `</tr></thead><tbody>`;
            data.rows.forEach(r => {
                tbl += '<tr>'; data.columns.forEach(c => tbl += `<td>${r[c]??''}</td>`); tbl += '</tr>';
            });
            tbl += `</tbody></table></div>`;
            res.show().html(tbl);
        });

        // ── Grand total toggle ──
        $(document).on('change', '.el-sec-gt', function () {
            $(this).closest('[data-secidx]').find('.el-gt-wrap').toggle($(this).is(':checked'));
        });

        // ── Label display update ──
        $(document).on('input', '.el-sec-label', function () {
            $(this).closest('[data-secidx]').find('.el-sec-lbl-disp')
                .text($(this).val() || 'Section');
        });
        $(document).on('input', '.el-sheet-name', function () {
            $(this).closest('[data-si]').find('.el-sheet-label').text($(this).val() || 'Sheet');
        });

        // ── Add Sheet ──
        $('#btnAddSheet').on('click', function () {
            elCollect();
            elData.sheets.push({ sheet: { sheet_name: `Sheet ${elData.sheets.length+1}` }, sections: [] });
            elRenderSheets();
            $(`#elSheet_${elData.sheets.length-1}`).addClass('show');
        });

        // ── Delete Sheet ──
        $(document).on('click', '.el-del-sheet', function (e) {
            e.stopPropagation();
            const si = $(this).closest('[data-si]').data('si');
            elCollect(); elData.sheets.splice(si, 1); elRenderSheets();
        });

        // ── Add Section ──
        $(document).on('click', '.el-add-section', function () {
            const si = $(this).closest('[data-si]').data('si');
            elCollect();
            elData.sheets[si].sections.push({
                section_label: 'New Section', sql_query:'', sql_where:'', visible_columns:'',
                layout:'vertical', group_id:0, side_gap:1, bottom_gap:2, display_mode:'TABLE',
                section_title:'', title_bg_color:'FFD700', title_font_color:'000000',
                header_bg_color:'FFD700', header_font_color:'000000',
                show_grand_total:0, grand_total_label:'TOTAL', total_bg_color:'FFD700'
            });
            elRenderSheets();
            $(`#elSheet_${si}`).addClass('show');
        });

        // ── Delete Section ──
        $(document).on('click', '.el-sec-del', function () {
            const si  = $(this).closest('[data-si]').data('si');
            const sec = $(this).closest('[data-secidx]').data('secidx');
            elCollect(); elData.sheets[si].sections.splice(sec, 1); elRenderSheets();
            $(`#elSheet_${si}`).addClass('show');
        });

        // ── Move Section ──
        $(document).on('click', '.el-sec-up', function () {
            const si = $(this).closest('[data-si]').data('si');
            const i  = $(this).closest('[data-secidx]').data('secidx');
            elCollect();
            const s = elData.sheets[si].sections;
            if (i > 0) [s[i-1], s[i]] = [s[i], s[i-1]];
            elRenderSheets(); $(`#elSheet_${si}`).addClass('show');
        });
        $(document).on('click', '.el-sec-down', function () {
            const si = $(this).closest('[data-si]').data('si');
            const i  = $(this).closest('[data-secidx]').data('secidx');
            elCollect();
            const s = elData.sheets[si].sections;
            if (i < s.length-1) [s[i+1], s[i]] = [s[i], s[i+1]];
            elRenderSheets(); $(`#elSheet_${si}`).addClass('show');
        });

        // ── Collect dari DOM → elData ──
        function elCollect() {
            elData.layout = {
                use_custom_layout: $('#el_use_custom').is(':checked') ? 1 : 0,
                report_title:      $('#el_title').val(),
                title_bg_color:    ($('#el_title_bg').val()||'#FFFFFF').replace('#',''),
                title_font_color:  ($('#el_title_fg').val()||'#000000').replace('#',''),
                title_font_size:   parseInt($('#el_title_size').val()) || 14
            };

            elData.sheets = [];
            $('#elSheetList [data-si]').each(function (si) {
                const sections = [];
                $(this).find('[data-secidx]').each(function () {
                    sections.push({
                        section_label:     $(this).find('.el-sec-label').val(),
                        sql_query:         $(this).find('.el-sec-query').val(),
                        sql_where:         $(this).find('.el-sec-where').val(),
                        visible_columns:   $(this).find('.el-sec-cols').val(),
                        layout:            $(this).find('.el-sec-layout').val(),
                        group_id:          parseInt($(this).find('.el-sec-group').val())||0,
                        side_gap:          parseInt($(this).find('.el-sec-sidegap').val())||1,
                        bottom_gap:        parseInt($(this).find('.el-sec-botgap').val())||2,
                        display_mode:      $(this).find('.el-sec-display').val(),
                        section_title:     $(this).find('.el-sec-title').val(),
                        title_bg_color:    ($(this).find('.el-sec-titlebg').val()||'#FFD700').replace('#',''),
                        title_font_color:  ($(this).find('.el-sec-titlefg').val()||'#000000').replace('#',''),
                        header_bg_color:   ($(this).find('.el-sec-headerbg').val()||'#FFD700').replace('#',''),
                        header_font_color: ($(this).find('.el-sec-headerfg').val()||'#000000').replace('#',''),
                        show_grand_total:  $(this).find('.el-sec-gt').is(':checked') ? 1 : 0,
                        grand_total_label: $(this).find('.el-sec-gt-label').val()||'TOTAL',
                        total_bg_color:    ($(this).find('.el-sec-totalbg').val()||'#FFD700').replace('#','')
                    });
                });
                elData.sheets.push({ sheet: { sheet_name: $(this).find('.el-sheet-name').val() }, sections });
            });
        }

        // ── Save Excel Layout ──
        $('#btnSaveExcelLayout').on('click', async function () {
            if (_reportId === 0) {
                Swal.fire('Info','Simpan report utama dulu sebelum save Excel Layout.','info'); return;
            }
            elCollect();
            $(this).prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span> Saving...');
            $('#elSaveStatus').text('');

            const res = await $.ajax({ url:'/MailReport/SaveExcelLayout', method:'POST',
                contentType:'application/json',
                data: JSON.stringify({ reportId: _reportId, layout: elData }) });

            $(this).prop('disabled', false).html('<i class="bi bi-check-lg me-1"></i>Save Excel Layout');

            if (res.ok) {
                $('#elSaveStatus').html('<span class="text-success">✓ Saved</span>');
                setTimeout(() => $('#elSaveStatus').text(''), 3000);
            } else {
                Swal.fire('Error', res.message, 'error');
            }
        });

        function elEsc(v) {
            if (!v) return '';
            return String(v).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
        }
    </script>
}
