@model IEnumerable<TMSBilling.Models.MailReportLog>
@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    ViewData["Title"] = "Send History";
    string? reportName = ViewBag.ReportName;
    int? reportId = ViewBag.ReportId;
}

<style>
    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1rem;
    }

    .tbl-log td, .tbl-log th {
        font-size: .78rem;
        vertical-align: middle;
    }

    .tbl-log th {
        font-size: .7rem;
        text-transform: uppercase;
        letter-spacing: .05em;
        color: #6c757d;
        background: #f8f9fa;
    }

    .badge-status {
        font-size: .68rem;
        padding: 2px 8px;
        border-radius: 20px;
        font-weight: 600;
    }

    .s-sent {
        background: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
    }

    .s-failed {
        background: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }

    .s-pending {
        background: #fff3cd;
        color: #856404;
        border: 1px solid #ffc107;
    }

    .s-retrying {
        background: #e2d9f3;
        color: #4a1f8e;
        border: 1px solid #c8b3e9;
    }

    .action-btn {
        padding: 2px 7px;
        font-size: .72rem;
    }

    .trigger-pill {
        font-size: .67rem;
        padding: 1px 7px;
        border-radius: 10px;
        border: 1px solid #dee2e6;
        background: #f8f9fa;
    }
</style>

<div class="page-header">
    <h6 style="font-size:.9rem;font-weight:700;margin:0;color:#344767;">
        <i class="bi bi-clock-history me-1 text-primary"></i>
        Send History
        @if (!string.IsNullOrEmpty(reportName))
        {
            <span class="text-muted fw-normal">— @reportName</span>
        }
    </h6>
    <div class="d-flex gap-2">
        @if (reportId.HasValue)
        {
            <a asp-action="Form" asp-route-id="@reportId" class="btn btn-sm btn-outline-warning">
                <i class="bi bi-pencil-square me-1"></i> Edit Report
            </a>
        }
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-2">
        <table class="table table-hover tbl-log mb-0" id="logTable">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Report</th>
                    <th>Trigger</th>
                    <th>Subject</th>
                    <th>TO</th>
                    <th>Status</th>
                    <th>Sent At</th>
                    <th>By</th>
                    <th>Retry</th>
                    <th style="width:90px;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model)
                {
                    <tr>
                        <td class="text-muted">@log.ID</td>
                        <td>@log.Report?.report_name</td>
                        <td><span class="trigger-pill">@log.trigger_type</span></td>
                        <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@log.subject_sent">
                            @log.subject_sent
                        </td>
                        <td style="max-width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@log.recipients_to">
                            @log.recipients_to
                        </td>
                        <td>
                            @{
                                var cls = log.status switch
                                {
                                    "SENT" => "s-sent",
                                    "FAILED" => "s-failed",
                                    "PENDING" => "s-pending",
                                    "RETRYING" => "s-retrying",
                                    _ => "s-pending"
                                };
                            }
                            <span class="badge-status @cls">@log.status</span>
                        </td>
                        <td>@(log.sent_at?.ToString("dd MMM yy HH:mm") ?? "—")</td>
                        <td class="text-muted">@log.triggered_by</td>
                        <td class="text-center">
                            @if (log.retry_count > 0)
                            {
                                <span class="text-warning">@log.retry_count×</span>
                            }
                            else
                            {

                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            <a asp-action="LogDetail" asp-route-id="@log.ID"
                               class="btn btn-sm btn-outline-secondary action-btn" title="View detail">
                                <i class="bi bi-eye"></i>
                            </a>
                            @if (log.status == "FAILED" || log.status == "PENDING")
                            {
                                <button class="btn btn-sm btn-outline-warning action-btn btnRetrigger"
                                        data-id="@log.ID" title="Retrigger">
                                    <i class="bi bi-arrow-repeat"></i>
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $('#logTable').DataTable({
                order: [[0, 'desc']],
                pageLength: 25,
                columnDefs: [{ orderable: false, targets: -1 }]
            });

            $('.btnRetrigger').click(async function () {
                const logId = $(this).data('id');
                const confirmed = await Swal.fire({
                    title: 'Retrigger this send?',
                    text: 'The email will be sent again using the same parameters.',
                    icon: 'question', showCancelButton: true,
                    confirmButtonText: 'Retrigger', confirmButtonColor: '#0d6efd'
                });

                if (!confirmed.isConfirmed) return;

                $(this).prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span>');

                const res = await $.post('/MailReport/Retrigger', { logId });
                if (res.ok) {
                    Swal.fire({ title: 'Sent!', text: `New log ID: ${res.logId}`, icon: 'success', timer: 2000, showConfirmButton: false })
                        .then(() => location.reload());
                } else {
                    Swal.fire('Failed', res.message, 'error');
                    $(this).prop('disabled', false).html('<i class="bi bi-arrow-repeat"></i>');
                }
            });
        });
    </script>
}
