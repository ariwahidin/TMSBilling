@model TMSBilling.Models.User

@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    ViewData["Title"] = Model.Id == 0 ? "Create User" : "Edit User";
    var allRoles = ViewBag.AllRoles as List<TMSBilling.Models.Role> ?? new();
    var assignedRoleIds = ViewBag.AssignedRoleIds as List<int> ?? new();
}

<input type="hidden" id="UserId" value="@Model.Id" />

<div class="form-group mt-3">
    <label>Username</label>
    <input type="text" id="Username" class="form-control" value="@Model.Username" />
</div>
<div class="form-group mt-3">
    <label>Password</label>
    <input type="password" id="Password" class="form-control" />
</div>
<div class="form-group mt-3">
    <label>Is Admin</label><br />
    <input type="checkbox" id="IsAdmin" @(Model.IsAdmin ? "checked" : "") />
</div>

<hr class="mt-4" />
<h5>Assign Roles</h5>
<p class="text-muted small">User akan mendapat semua permission dari role yang dipilih, termasuk inherited permission.</p>

<div class="row">
    @foreach (var role in allRoles)
    {
        <div class="col-md-4 mb-2">
            <div class="form-check">
                <input class="form-check-input role-checkbox"
                       type="checkbox"
                       value="@role.Id"
                       id="role_@role.Id"
                       @(assignedRoleIds.Contains(role.Id) ? "checked" : "") />
                <label class="form-check-label" for="role_@role.Id">
                    @role.Name
                    @if (!string.IsNullOrEmpty(role.Description))
                    {
                        <br>
                
                        <small class="text-muted">@role.Description</small>
                    }
                </label>
            </div>
        </div>
    }
</div>

<button id="btnSave" class="btn btn-primary mt-3">Save</button>
<div id="resultMsg" class="mt-3"></div>

@Html.AntiForgeryToken()

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $("#btnSave").click(function () {
            const id = $("#UserId").val();
            const isEdit = id && id !== "0";

            // const data = {
            //     Id: id,
            //     Username: $("#Username").val(),
            //     Password: $("#Password").val(),
            //     IsAdmin: $("#IsAdmin").is(":checked")
            // };

            const roleIds = [];
            document.querySelectorAll(".role-checkbox:checked").forEach(cb => {
                roleIds.push(parseInt(cb.value));
            });

            const data = {
                Id: id,
                Username: $("#Username").val(),
                Password: $("#Password").val(),
                RoleIds: roleIds
            };

            $.ajax({
                url: isEdit ? "/User/EditAjax" : "/User/CreateAjax",
                method: "POST",
                contentType: "application/json",
                data: JSON.stringify(data),
                success: function (response) {
                    if(response.success){
                        showToast(response.message, 'success')
                        setTimeout(() => {
                            window.location.href = '/User/Index';
                        }, 600);
                    }
                },
            });
        });
    </script>
}
