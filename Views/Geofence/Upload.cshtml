@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    ViewData["Title"] = "Upload Geofence";
}

<div class="container-fluid">
    <div class="mb-3">
        <a href="#" onclick="window.history.back()" class="btn btn-sm btn-primary">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>

    <div class="row">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title mb-3">Upload Geofence from Excel</h5>

                    <p class="text-muted small mb-3">
                        Use the <a href="/Geofence/DownloadTemplate">template</a> (includes a Reference Lists sheet
                        with valid Customer Group Code values). Header must be in row 1, data starts from row 2.
                        Latitude/Longitude must be within Indonesia's range.
                    </p>

                    <div class="mb-3">
                        <input type="file" id="excelFile" class="form-control" accept=".xlsx,.xls" />
                    </div>

                    <div id="uploadLoading" class="mb-3 text-muted" style="display:none;">
                        <span class="spinner-border spinner-border-sm"></span> Processing file...
                    </div>

                    <button class="btn btn-success" id="btnSubmitUpload">
                        <i class="bi bi-upload"></i> Upload
                    </button>
                    <a href="/Geofence/DownloadTemplate" class="btn btn-outline-secondary">
                        <i class="bi bi-download"></i> Download Template
                    </a>
                </div>
            </div>

            <div class="card mt-3" id="resultCard" style="display:none;">
                <div class="card-body" id="summaryContent"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $("#btnSubmitUpload").click(function () {
            const fileInput = document.getElementById("excelFile");
            if (!fileInput.files.length) {
                Swal.fire({ title: "No file selected", text: "Please select an Excel file first.", icon: "warning" });
                return;
            }

            const formData = new FormData();
            formData.append("file", fileInput.files[0]);

            $("#uploadLoading").show();
            $("#btnSubmitUpload").prop("disabled", true);
            $("#resultCard").hide();

            $.ajax({
                type: "POST",
                url: "/Geofence/Upload",
                data: formData,
                processData: false,
                contentType: false,
                success: function (res) {
                    renderSummary(res);
                    $("#resultCard").show();
                    $("#excelFile").val("");
                },
                error: function (xhr) {
                    const msg = xhr.responseJSON?.message || "Failed to upload file.";
                    Swal.fire({ title: "Error", text: msg, icon: "error" });
                },
                complete: function () {
                    $("#uploadLoading").hide();
                    $("#btnSubmitUpload").prop("disabled", false);
                }
            });
        });

        function renderSummary(res) {
            let html = `<h6 class="mb-3">Upload Result</h6>
            <div class="mb-3 d-flex flex-wrap gap-1">
                <span class="badge bg-secondary">Total processed: ${res.totalProcessed}</span>
                <span class="badge bg-success">Added: ${res.added.length}</span>
                <span class="badge bg-warning text-dark">Already exists: ${res.skippedExisting.length}</span>
                <span class="badge bg-warning text-dark">Customer not found: ${res.skippedCustomerNotFound.length}</span>
                <span class="badge bg-info text-dark">Duplicate in file: ${res.skippedDuplicateInFile.length}</span>
                <span class="badge bg-danger">Invalid: ${res.invalid.length}</span>
            </div>`;

            html += renderList("Successfully added", res.added, "success");
            html += renderList("Skipped (already exists)", res.skippedExisting, "warning");
            html += renderList("Skipped (Customer Group Code not found)", res.skippedCustomerNotFound, "warning");
            html += renderList("Skipped (duplicate within file)", res.skippedDuplicateInFile, "info");
            html += renderList("Invalid", res.invalid, "danger");

            $("#summaryContent").html(html);
        }

        function renderList(title, items, colorClass) {
            if (!items || items.length === 0) return "";
            let listItems = items.map(i => `<li>${i}</li>`).join("");
            return `<div class="mb-3">
                <strong class="text-${colorClass}">${title} (${items.length})</strong>
                <ul class="mb-0">${listItems}</ul>
            </div>`;
        }
    </script>
}