@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    ViewData["Title"] = "Import Data Price Sell";
}

@section Styles {
    <style>
        @@keyframes spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }

        .btn-loading {
            position: relative;
            pointer-events: none;
            opacity: 0.7;
        }

            .btn-loading::after {
                content: '';
                position: absolute;
                width: 14px;
                height: 14px;
                margin: auto;
                border: 2px solid transparent;
                border-top-color: #ffffff;
                border-radius: 50%;
                animation: spin 1s linear infinite;
                top: 0;
                left: 0;
                bottom: 0;
                right: 0;
            }
    </style>
}

<div class="d-flex align-items-center gap-2 flex-wrap">
    <a href="/PriceSell/Index" class="btn btn-primary">Back</a>
    <a href="/PriceSell/DownloadTemplate" class="btn btn-secondary">Download Template Excel</a>
    <input type="file" name="file" id="excelFile" accept=".xlsx" class="form-control" style="width:auto;" />
    <button type="button" class="btn btn-primary" id="previewBtn" onclick="previewExcel()">Preview</button>
    <select id="operationType" class="form-select" style="width:160px;">
        <option value="add">Add</option>
        <option value="edit">Edit</option>
    </select>
    <button class="btn btn-success" id="submitBtn" onclick="submitData()">Submit</button>
</div>

<hr />

<div id="resultCard"></div>

<h4>Preview Data</h4>
<p>Total rows: <span id="spanRows">0</span></p>

<div style="overflow-x:auto;">
    <table class="table table-bordered table-sm nowrap" id="previewTable" style="font-size:12px;">
        <thead></thead>
        <tbody></tbody>
    </table>
</div>

<!-- Loading Overlay -->
<div id="loadingOverlay" style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);display:none;justify-content:center;align-items:center;z-index:9999;">
    <div class="text-center">
        <div style="width:48px;height:48px;border:5px solid #f3f3f3;border-top:5px solid #007bff;border-radius:50%;animation:spin 1s linear infinite;margin:0 auto;"></div>
        <div id="loadingText" style="color:white;margin-top:16px;font-size:16px;font-weight:500;">Processing...</div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script>
        let parsedData = [];

        // Escape untrusted server/Excel text before inserting it into HTML.
        // Keep this helper global so submitData() and renderResultCard() can both use it.
        function htmlEscape(value) {
            return String(value ?? '').replace(/[&<>\"']/g, function (char) {
                const entities = {
                    '&': '&amp;',
                    '<': '&lt;',
                    '>': '&gt;',
                    '\"': '&quot;',
                    "'": '&#39;'
                };
                return entities[char];
            });
        }

        /* ── loading helpers ── */
        function showLoading(text) {
            document.getElementById('loadingText').textContent = text || 'Processing...';
            document.getElementById('loadingOverlay').style.display = 'flex';
        }
        function hideLoading() {
            document.getElementById('loadingOverlay').style.display = 'none';
        }
        function setButtonLoading(id, on) {
            const btn = document.getElementById(id);
            if (on) { btn.classList.add('btn-loading');    btn.disabled = true;  }
            else    { btn.classList.remove('btn-loading'); btn.disabled = false; }
        }

        /* ── excel date fix ── */
        function fixExcelDate(value) {
            if (typeof value === 'number') {
                const epoch = new Date(1899, 11, 30);
                return new Date(epoch.getTime() + value * 86400000).toISOString().split('T')[0];
            }
            if (typeof value === 'string') {
                const d = new Date(value);
                return isNaN(d) ? '' : d.toISOString().split('T')[0];
            }
            return '';
        }

        /* ── preview ── */
        function previewExcel() {
            const file = document.getElementById('excelFile').files[0];
            if (!file) return Swal.fire({ icon: 'warning', title: 'No File Selected', text: 'Please select an Excel file first.' });

            showLoading('Membaca file Excel...');
            setButtonLoading('previewBtn', true);

            const reader = new FileReader();
            reader.onload = function (e) {
                try {
                    const wb   = XLSX.read(new Uint8Array(e.target.result), { type: 'array' });
                    const ws   = wb.Sheets[wb.SheetNames[0]];
                    const json = XLSX.utils.sheet_to_json(ws, { defval: '' });

                    parsedData = json.map(row => ({
                        cust_code:      row.cust_code,
                        origin:         row.origin,
                        dest:           row.dest,
                        serv_type:      row.serv_type,
                        serv_moda:      row.serv_moda,
                        truck_size:     row.truck_size,
                        charge_uom:     row.charge_uom,
                        flag_min:       row.flag_min,
                        charge_min:     row.charge_min,
                        flag_range:     row.flag_range,
                        min_range:      row.min_range,
                        max_range:      row.max_range,
                        sell1:          row.sell1,
                        sell2:          row.sell2,
                        sell3:          row.sell3,
                        sell_ret_empty: row.sell_ret_empty,
                        sell_ret_cargo: row.sell_ret_cargo,
                        sell_ovnight:   row.sell_ovnight,
                        sell_cancel:    row.sell_cancel,
                        selltrip2:      row.selltrip2,
                        selltrip3:      row.selltrip3,
                        sell_diff_area: row.sell_diff_area,
                        valid_date:     fixExcelDate(row.valid_date),
                        active_flag:    row.active_flag,
                        curr:           row.curr,
                        rate_value:     row.rate_value,
                        rate_toll:      row.rate_toll === '' || row.rate_toll == null ? 0 : row.rate_toll,
                        rate_truck:     row.rate_truck === '' || row.rate_truck == null ? 0 : row.rate_truck,
                        rate_driver:    row.rate_driver === '' || row.rate_driver == null ? 0 : row.rate_driver
                    }));

                    setTimeout(() => {
                        renderTable(parsedData);
                        hideLoading();
                        setButtonLoading('previewBtn', false);
                    }, 300);

                } catch (err) {
                    console.error(err);
                    Swal.fire({ icon: 'error', title: 'Unable to Read Excel File', text: 'Please check the file format and try again.' });
                    hideLoading();
                    setButtonLoading('previewBtn', false);
                }
            };
            reader.readAsArrayBuffer(file);
        }

        /* ── render table ── */
        function renderTable(data) {
            const table = document.getElementById('previewTable');
            const thead = table.querySelector('thead');
            const tbody = table.querySelector('tbody');
            thead.innerHTML = '';
            tbody.innerHTML = '';
            document.getElementById('spanRows').textContent = data.length;

            if (!data.length) return;

            const headers = Object.keys(data[0]);
            thead.innerHTML = `<tr>${headers.map(h => `<th>${h}</th>`).join('')}</tr>`;
            tbody.innerHTML = data.map(item =>
                `<tr>${headers.map(h => `<td style="min-width:110px;">${item[h] ?? ''}</td>`).join('')}</tr>`
            ).join('');
        }

        /* ── submit ── */
        async function submitData() {
            if (!parsedData.length) {
                Swal.fire({ icon: 'warning', title: 'Preview Required', text: 'Please preview the Excel data before submitting.' });
                return;
            }

            const mode = document.getElementById('operationType').value;
            showLoading('Menyimpan data...');
            setButtonLoading('submitBtn', true);

            try {
                const response = await fetch('/PriceSell/UploadExcel', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ mode: mode, data: parsedData })
                });

                // Read the server response even for HTTP 400/409 so message/errors
                // can be shown in the inline result panel instead of being lost.
                const result = await response.json().catch(() => ({
                    message: `Server returned HTTP ${response.status}, but the response was not valid JSON.`
                }));

                hideLoading();
                setButtonLoading('submitBtn', false);

                result.httpStatus = response.status;
                result.isHttpSuccess = response.ok;
                renderResultCard(result);

                const errors = Array.isArray(result.errors) ? result.errors : [];
                const isApprovalSubmitted = response.ok && (
                    result.success === true ||
                    result.approvalId != null ||
                    result.requestNo != null
                );

                // Only successful approval submissions use SweetAlert.
                // Validation/server errors are displayed in the inline result card.
                if (isApprovalSubmitted) {
                    await Swal.fire({
                        icon: 'success',
                        title: 'Request Submitted Successfully',
                        html: `
                            <p class="mb-2">Your Price Sell import request has been submitted successfully.</p>
                            <p class="mb-2">The request is now <strong>pending approval</strong>. No tariff changes will be applied until it is approved.</p>
                            <p class="mb-0">Please contact your direct supervisor to review and approve this request.</p>
                        `,
                        confirmButtonText: 'Understood',
                        confirmButtonColor: '#198754'
                    });
                }
            } catch (err) {
                console.error(err);
                hideLoading();
                setButtonLoading('submitBtn', false);

                // Network/runtime failures also appear inline; no error SweetAlert.
                renderResultCard({
                    message: err.message || 'Unable to connect to the server. Please try again.',
                    errors: [],
                    skipped: [],
                    processed: [],
                    httpStatus: null,
                    isHttpSuccess: false
                });
            }
        }

        /* ── result card ── */
        function renderResultCard(result) {
            console.log('renderResultCard', result);

            const processed = Array.isArray(result.processed) ? result.processed : [];
            const skipped = Array.isArray(result.skipped) ? result.skipped : [];
            const errors = Array.isArray(result.errors) ? result.errors : [];
            const message = result.message || result.error || 'The import request could not be completed.';
            const isSuccess = result.isHttpSuccess === true;
            const statusText = result.httpStatus ? `HTTP ${result.httpStatus}` : 'Connection error';

            function makeSection(label, colorClass, items) {
                if (!items.length) return '';
                const lis = items.map(item =>
                    `<li class="list-group-item py-2 px-3" style="font-size:13px; white-space:pre-wrap;">${htmlEscape(item)}</li>`
                ).join('');
                return `
                    <div class="mt-3">
                        <p class="mb-1 fw-semibold ${colorClass}" style="font-size:14px;">${htmlEscape(label)} (${items.length})</p>
                        <ul class="list-group">${lis}</ul>
                    </div>`;
            }

            const html = `
                <div class="card mb-4 shadow-sm" id="uploadResultCard" style="max-width:1200px;">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>Upload Result</strong>
                        <button type="button" class="btn-close" aria-label="Close"
                                onclick="document.getElementById('uploadResultCard').remove()"></button>
                    </div>
                    <div class="card-body">
                        <div class="alert ${isSuccess ? 'alert-success' : 'alert-danger'} mb-3" role="alert">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <strong>${isSuccess ? 'Import request result' : 'Import could not be submitted'}</strong>
                                <small class="text-nowrap">${htmlEscape(statusText)}</small>
                            </div>
                            <div class="mt-1" style="white-space:pre-wrap;">${htmlEscape(message)}</div>
                        </div>

                        <div class="row g-2 mb-1">
                            <div class="col-4">
                                <div class="border border-success rounded text-center py-2">
                                    <div class="text-muted" style="font-size:12px;">Succeed</div>
                                    <div class="text-success fw-bold fs-3">${processed.length}</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="border border-warning rounded text-center py-2">
                                    <div class="text-muted" style="font-size:12px;">Skipped</div>
                                    <div class="text-warning fw-bold fs-3">${skipped.length}</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="border border-danger rounded text-center py-2">
                                    <div class="text-muted" style="font-size:12px;">Error</div>
                                    <div class="text-danger fw-bold fs-3">${errors.length}</div>
                                </div>
                            </div>
                        </div>

                        ${makeSection('Successfully processed', 'text-success', processed)}
                        ${makeSection('Skipped — already in the database', 'text-warning', skipped)}
                        ${makeSection('Error details', 'text-danger', errors)}

                        ${processed.length > 0 ? `
                        <div class="mt-3 text-end">
                            <a href="/PriceSell/Index" class="btn btn-primary btn-sm">View Data &rarr;</a>
                        </div>` : ''}
                    </div>
                </div>`;

            const container = document.getElementById('resultCard');
            if (!container) return;
            container.innerHTML = html;
            document.getElementById('uploadResultCard')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
    </script>
}
