<!-- Detail Modal -->
<div class="modal fade" id="detailModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <ul class="nav nav-tabs card-header-tabs" id="detailTabs">
                    <li class="nav-item">
                        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-request">
                            <i class="bi bi-upload me-1"></i>Request
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-response">
                            <i class="bi bi-download me-1"></i>Response
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-event">
                            <i class="bi bi-braces me-1"></i>Event Data
                        </button>
                    </li>
                    <li class="nav-item" id="tabErrorItem" style="display:none">
                        <button class="nav-link text-danger" data-bs-toggle="tab" data-bs-target="#tab-error">
                            <i class="bi bi-bug me-1"></i>Error
                        </button>
                    </li>
                </ul>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <div class="tab-content">
                    <div class="tab-pane fade show active p-3" id="tab-request">
                        <pre id="requestContent" class="bg-light rounded p-3 small overflow-auto mb-0" style="max-height:400px"></pre>
                    </div>
                    <div class="tab-pane fade p-3" id="tab-response">
                        <pre id="responseContent" class="bg-light rounded p-3 small overflow-auto mb-0" style="max-height:400px"></pre>
                    </div>
                    <div class="tab-pane fade p-3" id="tab-event">
                        <pre id="eventContent" class="bg-light rounded p-3 small overflow-auto mb-0" style="max-height:400px"></pre>
                    </div>
                    <div class="tab-pane fade p-3" id="tab-error">
                        <pre id="errorContent" class="bg-light rounded p-3 small overflow-auto mb-0" style="max-height:400px"></pre>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        function tryFormatJson(str) {
            try { return JSON.stringify(JSON.parse(str), null, 2); }
            catch { return str || '—'; }
        }

        function showDetail(id, focus) {
            const btn = event.target.closest('button');
            const row = btn.closest('tr');

            const reqBtn = row.querySelector('[data-request]');
            const resBtn = row.querySelector('[data-response]');
            const evtBtn = row.querySelector('[data-event]');
            const errBtn = row.querySelector('[data-error]');

            function safeGet(btn, attr) {
                if (!btn) return '';
                const raw = btn.dataset[attr];
                if (!raw) return '';
                try { return JSON.parse(raw) ?? ''; }
                catch { return raw; }
            }

            document.getElementById('requestContent').textContent  = tryFormatJson(safeGet(reqBtn, 'request'));
            document.getElementById('responseContent').textContent = tryFormatJson(safeGet(resBtn, 'response'));
            document.getElementById('eventContent').textContent    = tryFormatJson(safeGet(evtBtn, 'event'));
            document.getElementById('errorContent').textContent    = safeGet(errBtn, 'error');

            document.getElementById('tabErrorItem').style.display = errBtn ? 'block' : 'none';

            const modal = new bootstrap.Modal(document.getElementById('detailModal'));
            modal.show();

            const tabMap = { error: 'tab-error', payload: 'tab-request', event: 'tab-event' };
            const targetTab = document.querySelector(`[data-bs-target="#${tabMap[focus] ?? 'tab-request'}"]`);
            setTimeout(() => targetTab?.click(), 150);
        }
    </script>
}

