@model List<TMSBilling.Models.Integration>
@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    ViewData["Title"] = "Integration Hub";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-0 fw-bold">
                <i class="bi bi-diagram-3 text-primary me-2"></i>Integration Hub
            </h4>
            <small class="text-muted">Kelola integrasi event-driven ke channel eksternal</small>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="RecentHistory" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-clock-history me-1"></i>History
            </a>
            <a asp-action="Create" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg me-1"></i>Tambah Integrasi
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-3 bg-primary bg-opacity-10 p-3 me-3">
                            <i class="bi bi-diagram-3 text-primary fs-4"></i>
                        </div>
                        <div>
                            <div class="fs-4 fw-bold">@Model.Count</div>
                            <small class="text-muted">Total Integrasi</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-3 bg-success bg-opacity-10 p-3 me-3">
                            <i class="bi bi-check-circle text-success fs-4"></i>
                        </div>
                        <div>
                            <div class="fs-4 fw-bold">@Model.Count(x => x.IsActive)</div>
                            <small class="text-muted">Aktif</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-3 bg-warning bg-opacity-10 p-3 me-3">
                            <i class="bi bi-lightning text-warning fs-4"></i>
                        </div>
                        <div>
                            <div class="fs-4 fw-bold">@Model.Count(x => x.Timing == "realtime")</div>
                            <small class="text-muted">Realtime</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-3 bg-info bg-opacity-10 p-3 me-3">
                            <i class="bi bi-calendar-event text-info fs-4"></i>
                        </div>
                        <div>
                            <div class="fs-4 fw-bold">@Model.Count(x => x.Timing == "scheduled")</div>
                            <small class="text-muted">Scheduled</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Table -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Nama</th>
                            <th>Event Key</th>
                            <th>Channel</th>
                            <th>Timing</th>
                            <th>Status</th>
                            <th>Last Run</th>
                            <th>Next Run</th>
                            <th class="text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3">
                                    <div class="fw-semibold">@item.Name</div>
                                    @if (!string.IsNullOrEmpty(item.Description))
                                    {
                                        <small class="text-muted">@item.Description</small>
                                    }
                                </td>
                                <td>
                                    <code class="bg-light px-2 py-1 rounded small">@item.EventKey</code>
                                </td>
                                <td>
                                    @{
                                        var (channelIcon, channelColor) = item.ChannelType switch
                                        {
                                            "google_sheets" => ("bi-grid-3x3-gap", "success"),
                                            "sftp" => ("bi-hdd-network", "info"),
                                            "ftp" => ("bi-hdd", "secondary"),
                                            "api" => ("bi-cloud-arrow-up", "primary"),
                                            "file" => ("bi-file-earmark", "warning"),
                                            _ => ("bi-question", "secondary")
                                        };
                                    }
                                    <span class="badge bg-@channelColor bg-opacity-10 text-@channelColor">
                                        <i class="bi @channelIcon me-1"></i>@item.ChannelType.Replace("_", " ").ToUpper()
                                    </span>
                                </td>
                                <td>
                                    @if (item.Timing == "realtime")
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning">
                                            <i class="bi bi-lightning me-1"></i>Realtime
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info bg-opacity-10 text-info">
                                            <i class="bi bi-calendar me-1"></i>Scheduled
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input toggle-active" type="checkbox"
                                               data-id="@item.Id"
                                               @(item.IsActive ? "checked" : "")>
                                    </div>
                                </td>
                                <td>
                                    @if (item.LastRunAt.HasValue)
                                    {
                                        <div class="small">@item.LastRunAt.Value.ToString("dd/MM/yy HH:mm")</div>
                                        @if (item.LastRunStatus == "success")
                                        {
                                            <small class="text-success"><i class="bi bi-check-circle me-1"></i>Sukses</small>
                                        }
                                        else if (item.LastRunStatus == "failed")
                                        {
                                            <small class="text-danger"><i class="bi bi-x-circle me-1"></i>Gagal</small>
                                        }
                                    }
                                    else
                                    {
                                        <small class="text-muted">—</small>
                                    }
                                </td>
                                <td>
                                    @if (item.Timing == "scheduled" && item.NextRunAt.HasValue)
                                    {
                                        <small class="text-info">@item.NextRunAt.Value.ToString("dd/MM/yy HH:mm")</small>
                                    }
                                    else
                                    {
                                        <small class="text-muted">—</small>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-1">
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="History" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-secondary" title="History">
                                            <i class="bi bi-clock-history"></i>
                                        </a>
                                        <form asp-action="TriggerNow" asp-route-id="@item.Id" method="post"
                                              class="d-inline" title="Trigger Manual">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-success"
                                                    onclick="return confirm('Trigger integrasi sekarang?')">
                                                <i class="bi bi-play-fill"></i>
                                            </button>
                                        </form>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                                    onclick="return confirm('Hapus integrasi ini?')">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-5">
                                    <i class="bi bi-diagram-3 fs-1 d-block mb-2 opacity-25"></i>
                                    Belum ada integrasi. <a asp-action="Create">Tambah integrasi pertama</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.querySelectorAll('.toggle-active').forEach(toggle => {
    toggle.addEventListener('change', async function() {
        const id = this.dataset.id;
        const res = await fetch(`/Integration/ToggleActive/${id}`, {
            method: 'POST',
            headers: { 'RequestVerificationToken': document.querySelector('[name=__RequestVerificationToken]')?.value ?? '' }
        });
        if (!res.ok) {
            this.checked = !this.checked; // revert
            alert('Gagal mengubah status.');
        }
    });
});
</script>
@Html.AntiForgeryToken()
}
