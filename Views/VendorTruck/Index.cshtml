@model IEnumerable<TMSBilling.Models.VendorTruck>
@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    ViewData["Title"] = "Vendor Vehicle";
    var isAdmin = Context.Session.GetString("is_admin") == "true";
}

<div class="mb-3">
    @* <h4>Truck List</h4> *@
    <a class="btn btn-sm btn-primary" asp-action="Form">Add Truck</a>
    <a class="btn btn-sm btn-primary" href="/Vendor/Index">Back</a>
    <button class="btn btn-sm btn-success" id="btnUpload">
        <i class="bi bi-file-earmark-excel"></i> Upload Excel
    </button>
    <a class="btn btn-sm btn-outline-secondary" href="/VendorTruck/DownloadTemplate">
        <i class="bi bi-download"></i> Download Template
    </a>
</div>

<table class="table table-striped" id="truckTable">
    <thead>
        <tr>
            <th>Vehicle No</th>
            <th>Driver</th>
            <th>Size</th>
            <th>Vendor</th>
            <th>Status</th>
            <th style="width:100px;">Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.vehicle_no</td>
                <td>@item.vehicle_driver</td>
                <td>@item.vehicle_size</td>
                <td>@item.sup_code</td>
                <td>@(item.vehicle_active == 1 ? "Aktif" : "Tidak Aktif")</td>
                <td>
                    <a asp-action="Form" asp-route-id="@item.ID" class="btn btn-sm btn-warning">
                        <i class="bi bi-pencil-square"></i>
                    </a>
                    @if(isAdmin){
                    <button class="btn btn-sm btn-danger btnDelete" data-id="@item.ID">
                        <i class="bi bi-trash"></i>
                    </button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Upload Modal -->
<div class="modal fade" id="uploadModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Upload Vehicles from Excel</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-2">
                    Use the <a href="/VendorTruck/DownloadTemplate">template</a> (includes a Reference Lists sheet
                    with valid Vendor Code, Truck Size, Merk, Type, and Door Type values).
                    Header must be in row 1, data starts from row 2. Dates use format <code>yyyy-MM-dd</code>.
                </p>
                <input type="file" id="excelFile" class="form-control" accept=".xlsx,.xls" />
                <div id="uploadLoading" class="mt-2 text-muted" style="display:none;">
                    <span class="spinner-border spinner-border-sm"></span> Processing file...
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-success" id="btnSubmitUpload">Upload</button>
            </div>
        </div>
    </div>
</div>

<!-- Summary Modal -->
<div class="modal fade" id="summaryModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Upload Result</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="summaryContent"></div>
            <div class="modal-footer">
                <button class="btn btn-primary" id="btnCloseSummary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            let uploadModal = new bootstrap.Modal(document.getElementById("uploadModal"));
            let summaryModal = new bootstrap.Modal(document.getElementById("summaryModal"));

            $('#truckTable').DataTable();

            // $(".btnDelete").click(function () {
            //     if (!confirm("Yakin hapus data ini?")) return;

            //     $.post("/VendorTruck/Delete", { id: $(this).data("id") }, function () {
            //         location.reload();
            //     }).fail(function () {
            //         alert("Gagal menghapus data.");
            //     });
            // });

            $(".btnDelete").click(function () {
                const id = $(this).data("id");

                Swal.fire({
                    title: "Delete this record?",
                    text: "This action cannot be undone.",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonText: "Delete",
                    cancelButtonText: "Cancel",
                    confirmButtonColor: "#d33",
                    cancelButtonColor: "#3085d6"
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.post("/VendorTruck/Delete", { id: $(this).data("id") })
                            .done(() => {
                                Swal.fire({
                                    title: "Deleted",
                                    text: "Record deleted successfully.",
                                    icon: "success",
                                    timer: 1500,
                                    showConfirmButton: false
                                }).then(() => {
                                    location.reload();
                                });
                            })
                            .fail(() => {
                                Swal.fire({
                                    title: "Error",
                                    text: "Failed to delete the record.",
                                    icon: "error"
                                });
                            });
                    }
                });
            });


                    $("#btnUpload").click(function () {
            $("#excelFile").val("");
            uploadModal.show();
        });

        $("#btnSubmitUpload").click(function () {
            const fileInput = document.getElementById("excelFile");
            if (!fileInput.files.length) {
                Swal.fire({ title: "No file selected", text: "Please select an Excel file first.", icon: "warning" });
                return;
            }

            const formData = new FormData();
            formData.append("file", fileInput.files[0]);

            $("#uploadLoading").show();
            $("#btnSubmitUpload").prop("disabled", true);

            $.ajax({
                type: "POST",
                url: "/VendorTruck/Upload",
                data: formData,
                processData: false,
                contentType: false,
                success: function (res) {
                    uploadModal.hide();
                    renderSummary(res);
                    summaryModal.show();
                },
                error: function (xhr) {
                    const msg = xhr.responseJSON?.message || "Failed to upload file.";
                    Swal.fire({ title: "Error", text: msg, icon: "error" });
                },
                complete: function () {
                    $("#uploadLoading").hide();
                    $("#btnSubmitUpload").prop("disabled", false);
                }
            });
        });

        $("#btnCloseSummary").click(function () {
            location.reload();
        });

        function renderSummary(res) {
            let html = `<div class="mb-3 d-flex flex-wrap gap-1">
                <span class="badge bg-secondary">Total processed: ${res.totalProcessed}</span>
                <span class="badge bg-success">Added: ${res.added.length}</span>
                <span class="badge bg-warning text-dark">Already exists: ${res.skippedExisting.length}</span>
                <span class="badge bg-warning text-dark">Vendor not found: ${res.skippedVendorNotFound.length}</span>
                <span class="badge bg-warning text-dark">Truck size not found: ${res.skippedSizeNotFound.length}</span>
                <span class="badge bg-info text-dark">Duplicate in file: ${res.skippedDuplicateInFile.length}</span>
                <span class="badge bg-danger">Invalid: ${res.invalid.length}</span>
            </div>`;

            html += renderList("Successfully added", res.added, "success");
            html += renderList("Skipped (Vehicle No already exists)", res.skippedExisting, "warning");
            html += renderList("Skipped (Vendor Code not found in master)", res.skippedVendorNotFound, "warning");
            html += renderList("Skipped (Truck Size not found in master)", res.skippedSizeNotFound, "warning");
            html += renderList("Skipped (duplicate within file)", res.skippedDuplicateInFile, "info");
            html += renderList("Invalid", res.invalid, "danger");

            $("#summaryContent").html(html);
        }

        function renderList(title, items, colorClass) {
            if (!items || items.length === 0) return "";
            let listItems = items.map(i => `<li>${i}</li>`).join("");
            return `<div class="mb-3">
                <strong class="text-${colorClass}">${title} (${items.length})</strong>
                <ul class="mb-0">${listItems}</ul>
            </div>`;
        }

        });
    </script>
}
