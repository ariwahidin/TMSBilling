@model Dictionary<string, List<TMSBilling.Models.ReportDefinition>>
@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    ViewData["Title"] = "Reports";
}

<div class="page-header mb-4">
    <h4 class="mb-0"><i class="bi bi-file-earmark-bar-graph me-2 text-success"></i>Reports</h4>
    <small class="text-muted">Download data reports</small>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-inbox display-4 d-block mb-3"></i>
        Tidak ada report yang bisa diakses.
    </div>
}

@foreach (var group in Model)
{
    <div class="mb-4">
        <div class="d-flex align-items-center mb-2">
            <span class="fw-semibold text-muted" style="font-size:.75rem;text-transform:uppercase;letter-spacing:.5px;">
                <i class="bi bi-folder2 me-1"></i>@group.Key
            </span>
            <hr class="flex-grow-1 ms-2 my-0" />
        </div>

        <div class="row g-3">
            @foreach (var r in group.Value)
            {
                <div class="col-md-4 col-lg-3">
                    <div class="card h-100 shadow-sm hover-shadow" style="cursor:pointer;transition:box-shadow .15s;"
                         onclick="window.location.href='/Report/Generate/@r.ID'">
                        <div class="card-body py-3 px-3">
                            <div class="d-flex align-items-start gap-2">
                                <div class="report-icon-wrap rounded p-2"
                                     style="background:#f0f4ff;min-width:38px;text-align:center;">
                                    <i class="bi @(r.icon ?? "bi-file-earmark-bar-graph") text-primary fs-5"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="fw-semibold" style="font-size:.82rem;line-height:1.3;">
                                        @r.report_name
                                    </div>
                                    @if (!string.IsNullOrEmpty(r.report_desc))
                                    {
                                        <div class="text-muted mt-1" style="font-size:.72rem;">@r.report_desc</div>
                                    }
                                    <div class="mt-2">
                                        @foreach (var fmt in (r.allowed_outputs ?? "excel").Split(','))
                                        {
                                            var badge = fmt.Trim() switch {
                                                "excel" => ("bg-success-subtle text-success border border-success", "bi-file-earmark-excel"),
                                                "csv"   => ("bg-info-subtle text-info border border-info", "bi-file-earmark-text"),
                                                "pdf"   => ("bg-danger-subtle text-danger border border-danger", "bi-file-earmark-pdf"),
                                                _       => ("bg-secondary-subtle text-secondary border", "bi-file-earmark")
                                            };
                                            <span class="badge @badge.Item1 me-1" style="font-size:.65rem;">
                                                <i class="bi @badge.Item2 me-1"></i>@fmt.Trim().ToUpper()
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

<style>
.hover-shadow:hover { box-shadow: 0 4px 16px rgba(0,0,0,.12) !important; }
</style>
